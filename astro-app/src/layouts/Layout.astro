---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import SiteMeta from "../components/seo/SiteMeta.astro";
import type { HeroVariantType, LayoutPropsType, SeoType } from "../utils";
import "../styles/global.css";
import "swiper/css";

interface Props {
  seo: SeoType;
  layoutProps: LayoutPropsType | undefined;
  isHeroVideo?: boolean | undefined;
  heroVariants: HeroVariantType;
}

const { seo, layoutProps, isHeroVideo,heroVariants } = Astro.props || {};
const { footer, header } = layoutProps || {};
---

<html lang="nl">
  <head>
    <SiteMeta seo={seo} />

    <!-- ✅ Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=Roboto+Condensed:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <link href="https://db.onlinewebfonts.com/c/e781d1cba25f85543d695ab1c049cbf2?family=Antarctica+VAR" rel="stylesheet"/>

    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Roboto+Condensed:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">

    <!-- ✅ CDN Fonts -->
    <link
      href="https://fonts.cdnfonts.com/css/kontes-compressed"
      rel="stylesheet"
    />
    <link href="https://fonts.cdnfonts.com/css/barlow" rel="stylesheet" />

    <!-- ✅ Global CSS -->
    <link rel="stylesheet" href="/src/styles/global.css" />
    <!-- ✅ Favicon and App Icons -->
    <link
      rel="icon"
      type="image/png"
      href="/icons/favicon-96x96.png"
      sizes="96x96"
    />
    <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
    <link rel="shortcut icon" href="/icons/favicon.ico" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/icons/apple-touch-icon.png"
    />
    <meta name="apple-mobile-web-app-title" content="Every Media" />
    <link rel="manifest" href="/icons/site.webmanifest" />
    <!-- ✅ Favicon and App Icons -->
    <!-- ✅ Lenis Script to Bottom for Performance -->
    <script>
      if (typeof window !== 'undefined') {
        import('lenis').then(({ default: Lenis }) => {
          new Lenis({
            autoRaf: true
          });
        });
      }
    </script>
  </head>
  <body>
    <Header header={header} isHeroVideo={isHeroVideo} heroVariants={heroVariants}/>
    <main>
      <slot />
    </main>
    <Footer footer={footer} />
  </body>
</html>
