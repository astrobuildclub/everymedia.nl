---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import SiteMeta from "../components/seo/SiteMeta.astro";
import type {
  DefaultSeoPropsType,
  HeroVariantType,
  LayoutPropsType,
  SeoType,
} from "../utils";
import "../styles/global.css";
import CookieConsent from "../components/cookieconsent/CookieConsent.astro";
import { VisualEditing } from "@sanity/astro/visual-editing";

// Check both env var and URL parameter for preview mode
const previewParam = Astro.url.searchParams.get("preview") === "true";
const visualEditingEnabled =
  import.meta.env.PUBLIC_SANITY_VISUAL_EDITING_ENABLED == "true" || previewParam;
interface Props {
  seo: SeoType;
  layoutProps: LayoutPropsType | undefined;
  defaultSeoProps: DefaultSeoPropsType | undefined;
  heroVariants: HeroVariantType;
  currentPath: string;
}

const { seo, layoutProps, heroVariants, currentPath, defaultSeoProps } =
  Astro.props || {};
const { footer, header } = layoutProps || {};
const { analytics } = defaultSeoProps || {};
const { locale } = Astro.params || {};
---

<html lang={locale || "nl"}>
  <head>
    <SiteMeta
      seo={seo}
      currentPath={currentPath}
      defaultSeoProps={defaultSeoProps}
    />

    <link
      rel="stylesheet"
      href="https://unpkg.com/swiper/swiper-bundle.min.css"
    />

    <!-- ✅ Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=Roboto+Condensed:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />

    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Roboto+Condensed:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />

    <!-- ✅ CDN Fonts -->
    <link
      href="https://fonts.cdnfonts.com/css/kontes-compressed"
      rel="stylesheet"
    />
    <link href="https://fonts.cdnfonts.com/css/barlow" rel="stylesheet" />

    <!-- ✅ Global CSS -->
    <link rel="stylesheet" href="/src/styles/global.css" />
    <!-- ✅ Favicon and App Icons -->
    <link
      rel="icon"
      type="image/png"
      href="/icons/favicon-96x96.png"
      sizes="96x96"
    />
    <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
    <link rel="shortcut icon" href="/icons/favicon.ico" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/icons/apple-touch-icon.png"
    />
    <meta name="apple-mobile-web-app-title" content="Every Media" />
    <link rel="manifest" href="/icons/site.webmanifest" />
    <!-- ✅ Favicon and App Icons -->
    <!-- ✅ Lenis Script to Bottom for Performance -->
    <script>
      if (typeof window !== "undefined") {
        import("lenis").then(({ default: Lenis }) => {
          new Lenis({
            autoRaf: true,
          });
        });
      }
    </script>
    {/* Analytics */}
    {
      analytics?.googleAnalytics && (
        <script
          is:inline
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${analytics?.googleAnalytics}`}
        />
      )
    }
    {
      analytics?.googleAnalytics && (
        <script is:inline id="analytics">
          {`window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', '${analytics?.googleAnalytics}');
          `}
        </script>
      )
    }
    {
      analytics?.googleTagManager && (
        <script is:inline id="gtm">
          {`
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','${analytics?.googleTagManager}');
        `}
        </script>
      )
    }
    {
      analytics?.facebookPixel && (
        <script is:inline id="fb-pixel">
          {`
          !function(f,b,e,v,n,t,s)
          {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
          n.callMethod.apply(n,arguments):n.queue.push(arguments)};
          if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
          n.queue=[];t=b.createElement(e);t.async=!0;
          t.src=v;s=b.getElementsByTagName(e)[0];
          s.parentNode.insertBefore(t,s)}(window, document,'script',
          'https://connect.facebook.net/en_US/fbevents.js');
          fbq('init', '${analytics?.facebookPixel}');
          fbq('track', 'PageView');
         `}
        </script>
      )
    }
  </head>
  <body>
    {/* Google Tag Manager (noscript) */}
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${analytics?.googleTagManager}`}
        height="0"
        width="0"
        style={{ display: "none", visibility: "hidden" }}></iframe>
    </noscript>
    <Header header={header} heroVariants={heroVariants} />
    <main>
      <slot />
      <VisualEditing enabled={visualEditingEnabled} zIndex={9999} />
    </main>
    <Footer footer={footer} />
    <CookieConsent />
    {/* Preview parameter persistentie script */}
    {previewParam && (
      <script is:inline define:vars={{ previewParam }}>
        {
          `
          (function() {
            // Check if preview parameter is in URL
            const urlParams = new URLSearchParams(window.location.search);
            const isPreview = urlParams.get('preview') === 'true';
            
            if (!isPreview) return;
            
            // Function to add preview parameter to internal links
            function addPreviewToLink(href) {
              if (!href) return href;
              
              // Don't modify external links, mailto, tel, or anchors
              if (href.startsWith('http://') || 
                  href.startsWith('https://') || 
                  href.startsWith('mailto:') || 
                  href.startsWith('tel:') || 
                  href.startsWith('#')) {
                return href;
              }
              
              // Parse URL to handle existing query params
              try {
                const url = new URL(href, window.location.origin);
                url.searchParams.set('preview', 'true');
                return url.pathname + url.search + (url.hash || '');
              } catch (e) {
                // If URL parsing fails, append preview param manually
                const separator = href.includes('?') ? '&' : '?';
                return href + separator + 'preview=true';
              }
            }
            
            // Handle all existing links
            function updateLinks() {
              document.querySelectorAll('a[href]').forEach(link => {
                const originalHref = link.getAttribute('href');
                if (originalHref) {
                  const newHref = addPreviewToLink(originalHref);
                  if (newHref !== originalHref) {
                    link.setAttribute('href', newHref);
                  }
                }
              });
            }
            
            // Update links on page load
            if (document.readyState === 'loading') {
              document.addEventListener('DOMContentLoaded', updateLinks);
            } else {
              updateLinks();
            }
            
            // Use event delegation for dynamically added links
            document.addEventListener('click', function(e) {
              const link = e.target.closest('a[href]');
              if (link) {
                const href = link.getAttribute('href');
                if (href && !href.startsWith('http://') && 
                    !href.startsWith('https://') && 
                    !href.startsWith('mailto:') && 
                    !href.startsWith('tel:') && 
                    !href.startsWith('#')) {
                  const newHref = addPreviewToLink(href);
                  if (newHref !== href) {
                    link.setAttribute('href', newHref);
                  }
                }
              }
            }, true);
            
            // Observe DOM changes for dynamically added content
            if (window.MutationObserver) {
              const observer = new MutationObserver(function(mutations) {
                let shouldUpdate = false;
                mutations.forEach(function(mutation) {
                  if (mutation.addedNodes.length) {
                    mutation.addedNodes.forEach(function(node) {
                      if (node.nodeType === 1) { // Element node
                        if (node.tagName === 'A' && node.hasAttribute('href')) {
                          shouldUpdate = true;
                        } else if (node.querySelectorAll) {
                          const links = node.querySelectorAll('a[href]');
                          if (links.length > 0) {
                            shouldUpdate = true;
                          }
                        }
                      }
                    });
                  }
                });
                if (shouldUpdate) {
                  updateLinks();
                }
              });
              
              observer.observe(document.body, {
                childList: true,
                subtree: true
              });
            }
          })();
          `
        }
      </script>
    )}
  </body>
</html>
