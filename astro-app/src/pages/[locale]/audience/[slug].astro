---
import Pagebuilder from "../../../components/commons/Pagebuilder.astro";
import HeroView from "../../../components/HeroView.astro";
import Layout from "../../../layouts/Layout.astro";
import { loadQuery } from "../../../lib/load-query";
import { audienceQuery, type AudienceType } from "../../../utils";
import { getAudience } from "../../../utils/sanity/getAudience";

export async function getStaticPaths() {
  const { data: allSlugs } =
    (await loadQuery<Pick<AudienceType, "slug" | "language">[]>({
      query: audienceQuery?.query?.audienceSlugQuery,
    })) || [];

  const paths =
    allSlugs.map((item: Pick<AudienceType, "slug" | "language">) => ({
      params: { slug: item?.slug, locale: item?.language },
    })) || [];

  return paths;
}

const { slug, locale } = Astro.params;

const pageData = await getAudience<AudienceType>(slug as "", locale);

const {
  pagebuilder,
  seo,
  layoutProps,
  subtitle,
  heroVideo,
  title,
  heroImage,
  select,
  intro,
  pageTitle,
  variants,
  defaultSeoProps,
} = pageData || {};
const heroPage = {
  title,
  subtitle,
  heroVideo,
  heroImage,
  select,
  intro,
  pageTitle,
};
---

<Layout
  seo={seo || {}}
  layoutProps={layoutProps}
  defaultSeoProps={defaultSeoProps}
  heroVariants={variants}
  currentPath={`/${locale}/audience/${slug}`}
>
  <HeroView heroVariants={variants} data={heroPage} />
  {
    Array.isArray(pagebuilder) &&
      pagebuilder?.map((i) => <Pagebuilder data={i} />)
  }
</Layout>
