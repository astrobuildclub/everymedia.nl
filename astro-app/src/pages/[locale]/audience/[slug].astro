---
export const prerender = false;

import Section from "../../../components/commons/Section.astro";
import HeroView from "../../../components/HeroView.astro";
import Layout from "../../../layouts/Layout.astro";
import { loadQuery } from "../../../lib/load-query";
import {
  audienceQuery,
  type AudienceType,
  type HeroViewType,
} from "../../../utils";
import { getAudience } from "../../../utils/sanity/getAudience";

// export async function getStaticPaths() {
//   const { data: allSlugs } =
//     (await loadQuery<Pick<AudienceType, "slug" | "language">[]>({
//       query: audienceQuery?.query?.audienceSlugQuery,
//     })) || [];

//   const paths =
//     allSlugs.map((item: Pick<AudienceType, "slug" | "language">) => ({
//       params: { slug: item?.slug, locale: item?.language },
//     })) || [];

//   return paths;
// }

const { slug, locale } = Astro.params;

const pageData = await getAudience<AudienceType>(slug as "", locale as string);

const {
  pagebuilder,
  seo,
  layoutProps,
  subtitle,
  heroVideo,
  title,
  heroImage,
  select,
  intro,
  pageTitle,
  defaultSeoProps,
  _id,
  _type,
} = pageData || {};
const heroPage: HeroViewType = {
  title,
  subtitle,
  heroVideo,
  heroImage,
  select,
  intro,
  pageTitle,
  documentId: _id || "",
  documentType: _type || "",
};
---

<Layout
  seo={seo || {}}
  layoutProps={layoutProps}
  defaultSeoProps={defaultSeoProps}
  heroVariants={"audience"}
  currentPath={`/${locale}/audience/${slug}`}
>
  <HeroView data={heroPage} heroVariants={"audience"} />
  {
    Array.isArray(pagebuilder) && (
      <Section
        sections={pagebuilder}
        documentId={_id || ""}
        documentType={_type || ""}
      />
    )
  }
</Layout>
