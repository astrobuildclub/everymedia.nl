---
export const prerender = false;

import HeroView from "../../components/HeroView.astro";
import Layout from "../../layouts/Layout.astro";
import { type HeroViewType, type PageType } from "../../utils";
import { getPage } from "../../utils/sanity/getPage";
import Section from "../../components/commons/Section.astro";

const { locale } = Astro.params;
const searchParams = Astro.url.searchParams;

const pageData = await getPage<PageType>("/", locale as string, searchParams);

const {
  pagebuilder,
  seo,
  layoutProps,
  subtitle,
  heroVideo,
  title,
  heroImage,
  select,
  variants,
  intro,
  pageTitle,
  defaultSeoProps,
  _id,
  _type,
} = pageData || {};
const heroPage: HeroViewType = {
  title,
  subtitle,
  heroVideo,
  heroImage,
  select,
  intro,
  pageTitle,
  documentId: _id || "",
  documentType: _type || "",
};
---

<Layout
  seo={seo || {}}
  layoutProps={layoutProps}
  defaultSeoProps={defaultSeoProps}
  heroVariants={variants}
  currentPath={`/${locale}`}
>
  <HeroView data={heroPage} heroVariants={variants} />
  {
    Array.isArray(pagebuilder) && (
      <Section
        sections={pagebuilder}
        documentId={_id || ""}
        documentType={_type || ""}
      />
    )
  }
</Layout>
