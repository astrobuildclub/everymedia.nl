---
import groq from "groq";
import HeroView from "../../components/HeroView.astro";
import Layout from "../../layouts/Layout.astro";
import { type HeroViewType, type PageType } from "../../utils";
import { getPage } from "../../utils/sanity/getPage";
import { loadQuery } from "../../lib/load-query";
import Section from "../../components/commons/Section.astro";

export async function getStaticPaths() {
  const pageSlugQuery = groq`
*[_type == "page" && defined(slug.current) &&  (slug.current in ["/"])]{
"slug":slug.current,
language
}
`;
  const { data: allSlugs } =
    (await loadQuery<Pick<PageType, "slug" | "language">[]>({
      query: pageSlugQuery,
    })) || [];

  const paths =
    allSlugs.map((item: Pick<PageType, "slug" | "language">) => ({
      params: { locale: item?.language },
    })) || [];

  return paths;
}

const { locale } = Astro.params;

const pageData = await getPage<PageType>("/", locale);

const {
  pagebuilder,
  seo,
  layoutProps,
  subtitle,
  heroVideo,
  title,
  heroImage,
  select,
  variants,
  intro,
  pageTitle,
  defaultSeoProps,
  _id,
  _type,
} = pageData || {};
const heroPage: HeroViewType = {
  title,
  subtitle,
  heroVideo,
  heroImage,
  select,
  intro,
  pageTitle,
  documentId: _id || "",
  documentType: _type || "",
};
---

<Layout
  seo={seo || {}}
  layoutProps={layoutProps}
  defaultSeoProps={defaultSeoProps}
  heroVariants={variants}
  currentPath={`/${locale}`}
>
  <HeroView data={heroPage} heroVariants={variants} />
  {
    Array.isArray(pagebuilder) && (
      <Section
        sections={pagebuilder}
        documentId={_id || ""}
        documentType={_type || ""}
      />
    )
  }
</Layout>
