---
import Pagebuilder from "../../components/commons/Pagebuilder.astro";
import HeroView from "../../components/HeroView.astro";
import Layout from "../../layouts/Layout.astro";
import { loadQuery } from "../../lib/load-query";
import { pageQuery, type PageType } from "../../utils";
import { getPage } from "../../utils/sanity/getPage";

export async function getStaticPaths() {
  const { data: allSlugs } =
    (await loadQuery<Pick<PageType, "slug" | "language">[]>({
      query: pageQuery?.query?.pageSlugQuery,
    })) || [];

  const paths =
    allSlugs.map((item) => ({
      params: { slug: item?.slug, locale: item?.language },
    })) || [];

  return paths;
}

const { slug, locale } = Astro.params;

const pageData = await getPage<PageType>(slug, locale);

const {
  pagebuilder,
  seo,
  layoutProps,
  subtitle,
  heroVideo,
  title,
  heroImage,
  select,
  variants,
  intro,
  pageTitle,
  defaultSeoProps
} = pageData || {};
const heroPage = {
  title,
  subtitle,
  heroVideo,
  heroImage,
  select,
  intro,
  pageTitle,
};
---

<Layout
  seo={seo || {}}
  layoutProps={layoutProps}
  defaultSeoProps={defaultSeoProps}
  heroVariants={variants}
  currentPath={`/${locale}/${slug}`}
>
  <HeroView heroVariants={variants} data={heroPage} />
  {
    Array.isArray(pagebuilder) &&
      pagebuilder?.map((i) => <Pagebuilder data={i} />)
  }
</Layout>
