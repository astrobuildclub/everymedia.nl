---
import Pagebuilder from "../../components/commons/Pagebuilder.astro";
import HeroView from "../../components/HeroView.astro";
import Layout from "../../layouts/Layout.astro";
import { fetchDataFromSanity } from "../../lib/sanity";
import { pageQuery, type PageType } from "../../utils";
import { getPage } from "../../utils/sanity/getPage";

export async function getStaticPaths() {
  const allSlugs =
    (await fetchDataFromSanity<Pick<PageType, "slug" | "language">[]>({
      query: { groqQuery: pageQuery?.query?.pageSlugQuery },
    })) || [];

  const paths =
    allSlugs.map((item) => ({
      params: { slug: item?.slug, locale: item?.language },
    })) || [];

  return paths;
}

const { slug, locale } = Astro.params;

const pageData = await getPage<PageType>(slug, locale);

const {
  pagebuilder,
  seo,
  layoutProps,
  subtitle,
  heroVideo,
  title,
  heroImage,
  select,
  variants,
  intro
} = pageData || {};
const heroPage = { title, subtitle, heroVideo, heroImage, select ,intro};
const isHeroVideo = heroVideo || heroImage ? true : false;
---

<Layout seo={seo || {}} layoutProps={layoutProps} isHeroVideo={isHeroVideo}>
  <HeroView variants={variants} data={heroPage} />
  {
    Array.isArray(pagebuilder) &&
      pagebuilder?.map((i) => <Pagebuilder data={i} />)
  }
</Layout>
