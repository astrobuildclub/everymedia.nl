---
import Section from "../../components/commons/Section.astro";
import HeroView from "../../components/HeroView.astro";
import Layout from "../../layouts/Layout.astro";
import { loadQuery } from "../../lib/load-query";
import { pageQuery, type HeroViewType, type PageType } from "../../utils";
import { getPage } from "../../utils/sanity/getPage";

export async function getStaticPaths() {
  const { data: allSlugs } =
    (await loadQuery<Pick<PageType, "slug" | "language">[]>({
      query: pageQuery?.query?.pageSlugQuery,
    })) || [];

  const paths =
    allSlugs.map((item: Pick<PageType, "slug" | "language">) => ({
      params: { slug: item?.slug, locale: item?.language },
    })) || [];

  return paths;
}

const { slug, locale } = Astro.params;

const pageData = await getPage<PageType>(slug, locale);

const {
  pagebuilder,
  seo,
  layoutProps,
  subtitle,
  heroVideo,
  title,
  heroImage,
  select,
  variants,
  intro,
  pageTitle,
  defaultSeoProps,
  _id,
  _type,
} = pageData || {};
const heroPage: HeroViewType = {
  title,
  subtitle,
  heroVideo,
  heroImage,
  select,
  intro,
  pageTitle,
  documentId: _id || "",
  documentType: _type || "",
};
---

<Layout
  seo={seo || {}}
  layoutProps={layoutProps}
  defaultSeoProps={defaultSeoProps}
  heroVariants={variants}
  currentPath={`/${locale}/${slug}`}
>
  <HeroView data={heroPage} heroVariants={variants} />

  {
    Array.isArray(pagebuilder) && (
      <Section
        sections={pagebuilder}
        documentId={_id || ""}
        documentType={_type || ""}
      />
    )
  }
</Layout>
