---
import Section from "../../../components/commons/Section.astro";
import HeroView from "../../../components/HeroView.astro";
import Layout from "../../../layouts/Layout.astro";
import { loadQuery } from "../../../lib/load-query";
import {
  projectQuery,
  type HeroViewType,
  type ProjectType,
} from "../../../utils";
import { getProject } from "../../../utils/sanity/getProject";

export async function getStaticPaths() {
  const { data: allSlugs } =
    (await loadQuery<Pick<ProjectType, "slug" | "language">[]>({
      query: projectQuery?.query?.projectSlugQuery,
    })) || [];

  const paths =
    allSlugs.map((item: Pick<ProjectType, "slug" | "language">) => ({
      params: { slug: item?.slug, locale: item?.language },
    })) || [];

  return paths;
}

const { slug, locale } = Astro.params;

const pageData = await getProject<ProjectType>(slug as "", locale);

const {
  pagebuilder,
  seo,
  layoutProps,
  subtitle,
  heroVideo,
  title,
  heroImage,
  select,
  intro,
  pageTitle,
  client,
  tag,
  defaultSeoProps,
  _id,
  _type,
} = pageData || {};
const heroPage: HeroViewType = {
  title,
  subtitle,
  heroVideo,
  heroImage,
  select,
  intro,
  pageTitle,
  client,
  tag,
  documentId: _id || "",
  documentType: _type || "",
};
---

<Layout
  seo={seo || {}}
  layoutProps={layoutProps}
  defaultSeoProps={defaultSeoProps}
  heroVariants={"project"}
  currentPath={`/${locale}/projects/${slug}`}
>
  <HeroView data={heroPage} heroVariants={"project"} />
  {
    Array.isArray(pagebuilder) && (
      <Section
        sections={pagebuilder}
        documentId={_id || ""}
        documentType={_type || ""}
      />
    )
  }
</Layout>
