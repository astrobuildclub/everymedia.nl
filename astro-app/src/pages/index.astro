---
import Pagebuilder from "../components/commons/Pagebuilder.astro";
import HeroView from "../components/HeroView.astro";
import Layout from "../layouts/Layout.astro";
import { type PageType } from "../utils";
import { getPage } from "../utils/sanity/getPage";

const pageData = await getPage<PageType>("/", "en");

const {
  pagebuilder,
  seo,
  layoutProps,
  subtitle,
  heroVideo,
  title,
  heroImage,
  select,
  variants,
  intro
} = pageData || {};
const heroPage = { title, subtitle, heroVideo, heroImage, select,intro};
const isHeroVideo = heroVideo || heroImage ? true : false;
---

<Layout seo={seo || {}} layoutProps={layoutProps} isHeroVideo={isHeroVideo}>
  <HeroView variants={variants} data={heroPage} />
  {
    Array.isArray(pagebuilder) &&
      pagebuilder?.map((i) => <Pagebuilder data={i} />)
  }
</Layout>