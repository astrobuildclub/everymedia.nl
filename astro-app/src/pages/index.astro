---
import Pagebuilder from "../components/commons/Pagebuilder.astro";
import HeroView from "../components/HeroView.astro";
import Layout from "../layouts/Layout.astro";
import { defaultLanguage } from "../lib/helperFunctions";
import { type PageType } from "../utils";
import { getPage } from "../utils/sanity/getPage";

const pageData = await getPage<PageType>("/", defaultLanguage?.id);

const {
  pagebuilder,
  seo,
  layoutProps,
  subtitle,
  heroVideo,
  title,
  heroImage,
  select,
  variants,
  intro,
  pageTitle,
  defaultSeoProps
} = pageData || {};
const heroPage = {
  title,
  subtitle,
  heroVideo,
  heroImage,
  select,
  intro,
  pageTitle,
};
---

<Layout
  seo={seo || {}}
  layoutProps={layoutProps}
  defaultSeoProps={defaultSeoProps}
  heroVariants={variants}
  currentPath={`/${defaultLanguage?.id}`}
>
  <HeroView heroVariants={variants} data={heroPage} />
  {
    Array.isArray(pagebuilder) &&
      pagebuilder?.map((i) => <Pagebuilder data={i} />)
  }
</Layout>
