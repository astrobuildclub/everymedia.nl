---
export const prerender = false;

import Section from "../components/commons/Section.astro";
import HeroView from "../components/HeroView.astro";
import Layout from "../layouts/Layout.astro";
import { defaultLanguage } from "../lib/helperFunctions";
import { type HeroViewType, type PageType } from "../utils";
import { getPage } from "../utils/sanity/getPage";

const pageData = await getPage<PageType>("/", defaultLanguage?.id);

const {
  pagebuilder,
  seo,
  layoutProps,
  subtitle,
  heroVideo,
  title,
  heroImage,
  select,
  variants,
  intro,
  pageTitle,
  defaultSeoProps,
  _id,
  _type,
} = pageData || {};
const heroPage: HeroViewType = {
  title,
  subtitle,
  heroVideo,
  heroImage,
  select,
  intro,
  pageTitle,
  documentId: _id || "",
  documentType: _type || "",
};
---

<Layout
  seo={seo || {}}
  layoutProps={layoutProps}
  defaultSeoProps={defaultSeoProps}
  heroVariants={variants}
  currentPath={`/${defaultLanguage?.id}`}
>
  <HeroView data={heroPage} heroVariants={variants} />
  {
    Array.isArray(pagebuilder) && (
      <Section
        sections={pagebuilder}
        documentId={_id || ""}
        documentType={_type || ""}
      />
    )
  }
</Layout>
