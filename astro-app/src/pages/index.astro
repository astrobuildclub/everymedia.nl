---
import Pagebuilder from "../components/commons/Pagebuilder.astro";
import HeroPage from "../components/HeroPage.astro";
import Layout from "../layouts/Layout.astro";
import { getPage, type PageType } from "../utils";

const pageData = await getPage<PageType>("/");

const {
  pagebuilder,
  seo,
  layoutProps,
  subtitle,
  heroVideo,
  title,
  heroImage,
  select,
  variants,
} = pageData || {};
const heroPage = { title, subtitle, heroVideo, heroImage, select };
const isHeroVideo = heroVideo || heroImage ? true : false;

---

<Layout seo={seo || {}} layoutProps={layoutProps} isHeroVideo={isHeroVideo}>
  {variants === "homepage" && <HeroPage data={heroPage} />}
  {
    Array.isArray(pagebuilder) &&
      pagebuilder?.map((i) => <Pagebuilder data={i} />)
  }
</Layout>
