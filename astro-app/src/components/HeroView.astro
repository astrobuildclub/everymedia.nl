---
import type { HeroVariantType, HeroViewType,} from "../utils";
import HeroAudience from "./HeroAudience.astro";
import HeroHomePage from "./HeroHomePage.astro";
import HeroPage from "./HeroPage.astro";
import HeroProject from "./HeroProject.astro";

interface Props {
  data: HeroViewType
  heroVariants: HeroVariantType;
}

const { data, heroVariants } = Astro.props || {};
---

{
  (() => {
    switch (heroVariants) {
      case "homepage":
        return <HeroHomePage data={data} />;
      case "audience":
        return <HeroAudience data={data} />;
      case "project":
        return <HeroProject data={data} />;
      case "page":
        return <HeroPage data={data} />;
      default:
        return null;
    }
  })()
}
