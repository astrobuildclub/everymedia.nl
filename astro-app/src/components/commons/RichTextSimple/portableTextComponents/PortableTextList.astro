---
import type { Props as $, List } from "astro-portabletext/types";

export type Props = $<List>;

const { node, index, isInline, ...attrs } = Astro.props || {};
const listItemIs = (listItem: string) => listItem === node.listItem;
---

{
    listItemIs("number") ? (
        <ol {...attrs}>
            <slot />
        </ol>
    ) : (
        <ul {...attrs}>
            <slot />
        </ul>
    )
}

<style>
    ul {
      display: flex;
      flex-direction: column;
      list-style: disc;
      padding-left: 1.2rem;
      margin-top: 2.5rem;
    }
    ol {
      display: flex;
      flex-direction: column;
      list-style: decimal;
      padding-left: 1.2rem;
      margin-top: 2.5rem;
    }
</style>
