---
import { PortableText } from "astro-portabletext";
import type { ProjectType } from "../../utils";
import SanityImage from "../commons/SanityImage.astro";
import SimpleVideo from "./SimpleVideo.astro";
import { routes } from "../../lib/router";
import { defaultLanguage } from "../../lib/helperFunctions";
import { stegaClean } from "@sanity/client/stega";

interface Props {
  projects: ProjectType[];
}
const { projects = [] } = Astro.props || {};
const locale = Astro.params?.locale || defaultLanguage.id;
---

{
  (() => {
    return (
      <div class="swiper" data-projects-swiper>
        <div class="swiper-wrapper">
          {projects?.map((item) => {
            const {
              title,
              heroImage,
              select: Select,
              heroVideo,
              intro,
              subtitle,
              client,
              tag,
              slug,
              _id,
              _type,
            } = item || {};
            const select = stegaClean(Select || "");
            const href =
              typeof slug === "object" && slug?.current
                ? routes?.project({ language: locale ?? "", slug: slug.current })
                : null;

            return (
              <article class="swiper-slide project-card">
                <div class="project__meta">
                  <div>
                    {select === "heroImage" && heroImage && (
                      <div class="media-container">
                        <SanityImage
                          src={heroImage}
                          className="media"
                          documentId={_id}
                          documentType={_type}
                          sanityFieldName="heroImage"
                        />
                      </div>
                    )}
                    {select === "heroVideo" && heroVideo && (
                      <div class="media-container">
                        <SimpleVideo
                          autoplay={true}
                          loop={true}
                          className="media"
                          videoUrl={heroVideo}
                          documentId={_id}
                          documentType={_type}
                          sanityFieldName="heroVideo"
                        />
                      </div>
                    )}
                  </div>
                  <div class="project__meta">
                    <div class="meta">
                      {client && <h4>{client}</h4>}
                      {tag && <p>{tag}</p>}
                    </div>
                    <div class="project-details">
                      {title &&
                        (href ? (
                          <a class="project-link" href={href}>
                            <h3>{title}</h3>
                          </a>
                        ) : (
                          <h3>{title}</h3>
                        ))}
                      {subtitle && <span>{subtitle}</span>}
                      {intro && (
                        <div class="intro-text">
                          <PortableText value={intro} />
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    );
  })()
}

<script>
  import Swiper from "swiper";
  import { Pagination } from "swiper/modules";
  import "swiper/css";
  import "swiper/css/pagination";
  import { onPageLeave } from "../../lib/carousel";

  const init = () => {
    document.querySelectorAll<HTMLElement>("[data-projects-swiper]").forEach((el) => {
      if (el.dataset.swiperReady === "true") return;
      el.dataset.swiperReady = "true";
      const swiper = new Swiper(el, {
        modules: [Pagination],
        slidesPerView: "auto",
        spaceBetween: 30,
        loop: true,
        pagination: {
          el: ".swiper-pagination",
          clickable: true,
        },
        breakpoints: {
          1024: {
            slidesPerView: 2.1,
          },
          767: {
            slidesPerView: 1.5,
          },
          640: {
            slidesPerView: 1.2,
          },
        },
      });
      onPageLeave(() => swiper.destroy(true, false));
    });
  };

  // Ook na navigatie met <ClientRouter /> (guard voorkomt dubbel starten).
  document.addEventListener("astro:page-load", init);
</script>

<style>
  /*
   * Hele kaart klikbaar (stretched link). De link zelf blijft om de titel,
   * zodat screenreaders een duidelijke linktekst hebben.
   */
  .project-card {
    position: relative;
  }

  .project-link {
    color: inherit;
    text-decoration: none;

    &::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
    }

    &:focus-visible {
      outline: none;
    }
  }

  .project-card:has(.project-link:focus-visible) {
    outline: 2px solid var(--card-focus, #fff);
    outline-offset: 4px;
    border-radius: 0.75rem;
  }

  .project-card:hover h3 {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.12em;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .project-card :global(.media) {
      transition: transform 0.5s ease;
    }

    .project-card:hover :global(.media) {
      transform: scale(1.03);
    }
  }

  /*
   * Vaste 16:9-uitsnede: video's en beelden hebben verschillende
   * verhoudingen. Het beeld vult de container (cover) en zoomt bij hover
   * binnen de container; de kaart zelf verandert niet van maat.
   */
  .media-container {
    aspect-ratio: 16 / 9;
    border-radius: 4px;
    margin-bottom: 0.75rem;
    width: 100%;
    overflow: hidden;

    :global(figure) {
      height: 100%;
      margin: 0;
    }

    :global(.media) {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .project__meta {

    .meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.375rem;

      h4 {
        font-family: var(--font-mono);
        color: var(--cool-gray);
        font-weight: 500;
        letter-spacing: 0.36px;
        text-transform: uppercase;
        font-size: 0.75rem;
      }

      p {
        font-family: var(--font-mono);
        font-size: 0.651rem;
        color: var(--cool-gray);
        background-color: var(--jet);
        border-radius: 9999px;
        letter-spacing: 0.304px;
        font-weight: 500;
        text-transform: uppercase;
        padding: var(--space-3xs) var(--space-xs-s);
        line-height: 150%;
      }
    }

    .project-details {
      display: flex;
      flex-direction: column;
      gap: 0.375rem;

      h3 {
        font-weight: 700;
        font-family: var(--font-primary);
        font-size: 1.5rem;
        letter-spacing: -0.48px;
        line-height: 112.5%;
        color: white;
      }
      span {
        color: white;
        font-size: var(--fs--1);
        letter-spacing: -2%;
        line-height: 112%;
        font-weight: 500;
        letter-spacing: -0.36px;
        font-family: var(--font-primary);
      }
      .intro-text {
        color: var(--neutrals-600);
        font-size: var(--fs--2);
        font-weight: normal;
        line-height: 150%;
        letter-spacing: 0.25px;
        font-family: var(--font-primary);
      }
    }
  }
</style>
