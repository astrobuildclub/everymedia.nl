---
import { Link, type LinkProps } from "sanity-plugin-link-field/component";
import { resolveLink } from "../../lib/resolveLink";

interface Props {
  href: LinkProps;
  className: string;
}

const { href, className } = Astro.props || {};
---
<Link
  link={href as any}
  hrefResolver={({ internalLink }) =>
    resolveLink({
      type: internalLink?._type,
      slug: internalLink?.slug?.current,
    })}
  className={className}
>
  <slot />
</Link>
