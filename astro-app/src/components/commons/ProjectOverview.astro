---
import { PortableText } from "astro-portabletext";
import type { ProjectType } from "../../utils";
import SanityImage from "./SanityImage.astro";
import SimpleVideo from "./SimpleVideo.astro";
import { routes } from "../../lib/router";
import { defaultLanguage } from "../../lib/helperFunctions";
import { stegaClean } from "@sanity/client/stega";

interface Props {
  project: ProjectType;
}
const {
  title,
  heroImage,
  select: Select,
  heroVideo,
  subtitle,
  intro,
  client,
  tag,
  slug,
  _type,
  _id,
} = Astro.props.project || {};
const locale = Astro.params?.locale || defaultLanguage.id;
const select = stegaClean(Select || "");
const href =
  typeof slug === "object" && slug?.current
    ? routes?.project({ language: locale ?? "", slug: slug.current })
    : null;
---

{
  (() => {
    return (
      <article class="project-card">
        <div class="project__meta">
          <div>
            {select === "heroImage" && heroImage && (
              <div class="media-container">
                <SanityImage
                  src={heroImage}
                  className="media"
                  captionClassName="caption-style"
                  documentId={_id}
                  documentType={_type}
                  sanityFieldName="heroImage"
                />
              </div>
            )}
            {select === "heroVideo" && heroVideo && (
              <div class="media-container">
                <SimpleVideo
                  autoplay={true}
                  loop={true}
                  className="media"
                  videoUrl={heroVideo}
                  documentId={_id}
                  documentType={_type}
                  sanityFieldName="heroVideo"
                />
              </div>
            )}
          </div>
          <div class="project__meta">
            <div class="meta">
              {client && <h4>{client}</h4>}
              {tag && <p>{tag}</p>}
            </div>
            <div class="project-details">
              {title &&
                (href ? (
                  <a class="project-link" href={href}>
                    <h3>{title}</h3>
                  </a>
                ) : (
                  <h3>{title}</h3>
                ))}
              {subtitle && <span>{subtitle}</span>}
              {intro && (
                <div class="intro-text">
                  <PortableText value={intro} />
                </div>
              )}
            </div>
          </div>
        </div>
      </article>
    );
  })()
}

<style>
  /*
   * Hele kaart klikbaar (stretched link). De link zelf blijft om de titel,
   * zodat screenreaders een duidelijke linktekst hebben.
   */
  .project-card {
    position: relative;
  }

  .project-link {
    color: inherit;
    text-decoration: none;

    &::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
    }

    &:focus-visible {
      outline: none;
    }
  }

  .project-card:has(.project-link:focus-visible) {
    outline: 2px solid var(--card-focus, #000);
    outline-offset: 4px;
    border-radius: 0.75rem;
  }

  .project-card:hover h3 {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.12em;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .project-card :global(.media) {
      transition: transform 0.5s ease;
    }

    .project-card:hover :global(.media) {
      transform: scale(1.03);
    }
  }

  .project__meta {
    .media-container {
      border-radius: 0.75rem;
      margin-bottom: 0.75rem;
      width: 100%;
      overflow: hidden;
    }
    .media {
      border-radius: 0.75rem;
      /* aspect-ratio: 696 / 391; */
      width: 100%;
    }

    .meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.375rem;

      h4 {
        font-family: var(--font-mono);
        color: var(--blue-gray-700);
        font-weight: 500;
        letter-spacing: 3%;
        text-transform: uppercase;
        font-size: 0.75rem;
      }

      p {
        font-family: var(--font-mono);
        font-size: 0.651rem;
        color: var(--blue-gray-800);
        background-color: var(--blue-gray-200);
        border-radius: 9999px;
        letter-spacing: 3%;
        font-weight: 500;
        text-transform: uppercase;
        padding: 0.313rem 0.563rem;
        line-height: 100%;
      }
    }

    .project-details {
      display: flex;
      flex-direction: column;
      gap: 0.375rem;

      h3 {
        font-weight: 700;
        font-family: var(--font-primary);
        font-size: var(--fs-2);
        line-height: 1;
        color: var(--blue-gray-900);
        text-transform: uppercase;
      }

      span {
        color: black;
        font-size: var(--fs--1);
        letter-spacing: -2%;
        line-height: 112%;
        font-weight: 500;
        font-family: var(--font-primary) !important;
      }

      .intro-text {
        color: var(--gray-800);
        font-size: var(--fs--2);
        font-weight: normal;
        line-height: 150%;
      }
    }
  }
</style>
