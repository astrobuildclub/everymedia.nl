---
import { cn } from "../../lib/helperFunctions";
import type { ButtonType, ButtonVariantType } from "../../utils";
import SanityLink from "./SanityLink.astro";

interface Props {
  block: ButtonType;
  className?: string;
}

const { block, className = "" } = Astro.props;

const { variant, link, buttonText: label } = block || {};

const buttonVariants: Record<ButtonVariantType, string> = {
  white: "white-btn",
  black: "black-btn",
};

const variantClasses = buttonVariants[variant] || "";
---

{
  link ? (
    <SanityLink href={link} className={cn(variantClasses, className)}>
      <span>{label}</span>
    </SanityLink>
  ) : (
    <button class={cn(variantClasses, className)}>
      <span>{label}</span>
    </button>
  )
}
