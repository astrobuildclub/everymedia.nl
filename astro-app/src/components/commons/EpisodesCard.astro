---
import { stegaClean } from "@sanity/client/stega";
import type { EpisodeType } from "../../utils";
import VimeoVideo from "../commons/VimeoVideo.astro";
import YoutubeVideo from "../commons/YoutubeVideo.astro";
import CarouselNav from "./CarouselNav.astro";
import DragCursor from "./DragCursor.astro";
import { getTranslation } from "../../i18n/translate";
import { defaultLanguage } from "../../lib/helperFunctions";

interface Props {
  episodes: EpisodeType[];
}

const { episodes } = Astro.props || {};
const locale = Astro.params?.locale || defaultLanguage.id;
const { t } = getTranslation(locale);
---

{
  (() => {
    return (
      <div
        class="episodes-carousel carousel-cards"
        data-episodes-carousel
        data-carousel-root
        data-autoplay="false"
        data-first-slide-message={t("carouselFirstSlide")}
        data-last-slide-message={t("carouselLastSlide")}
        data-slide-label-message={t("carouselSlideLabel")}
        aria-roledescription="carousel"
        aria-label={t("episodesCarousel")}
      >
      {episodes?.length > 1 && <CarouselNav class="episodes-carousel-nav" />}
      <div class="swiper" data-drag-area>
        <div class="swiper-wrapper">
          {episodes?.map((item) => {
            const {
              description,
              thumbType,
              title,
              thumbnailUrl,
              thumbnailFile,
              vimeoId,
              select: Select,
              youtubeId,
            } = item || {};
            const poster =
              thumbType === "file"
                ? thumbnailFile?.asset?.url
                : thumbType === "url"
                  ? thumbnailUrl
                  : "";
            const select = stegaClean(Select || "");

            return (
              <article class="swiper-slide">
                <div class="project__meta">
                  {select === "vimeo" && vimeoId && (
                    <VimeoVideo
                      className="vimeo-video"
                      vimeoId={vimeoId}
                      title={title}
                      poster={poster}
                    />
                  )}
                  {select === "youtube" && youtubeId && (
                    <YoutubeVideo
                      className="youtube-video"
                      videoId={youtubeId}
                      title={title}
                      poster={poster}
                    />
                  )}
                  <div class="block-episodes-about">
                    {title && <h3 class="episode-swiper-title">{title}</h3>}
                    {description && (
                      <p class="episode-swiper-subTitle">{description}</p>
                    )}
                  </div>
                </div>
              </article>
            );
          })}
        </div>
        <DragCursor tone="dark" />
      </div>
      </div>
    );
  })()
}

<script>
  import "swiper/css";
  import { initCarousels } from "../../lib/carousel";

  // Zelfde gedrag als de andere carousels: slepen, swipen, pijlen, links uitgelijnd.
  // Ook na navigatie met <ClientRouter /> (guard voorkomt dubbel starten).
  document.addEventListener("astro:page-load", () =>
    initCarousels("[data-episodes-carousel]", {
      slidesPerView: "auto",
      spaceBetween: 16,
      breakpoints: { 640: { spaceBetween: 30 } },
    })
  );
</script>

<style>
  .episodes-carousel :global(.episodes-carousel-nav) {
    margin-block-end: var(--space-s);

    @media (min-width: 640px) {
      padding-inline-end: var(--space-s);
    }
  }

  .project__meta {
    .vimeo-video {
      border-radius: 4px;
      aspect-ratio: 696 / 391;
      width: 100%;
      border: none !important;
      max-width: 100%;
    }
    .youtube-video {
      border-radius: 4px;
      aspect-ratio: 696 / 391;
      width: 100%;
      border: none !important;
      max-width: 100%;
    }

    .video-thumb {
      .thumb-image {
        border-radius: 4px;
        aspect-ratio: 696 / 391;
        width: 100%;
      }
    }

    .block-episodes-about {
      display: flex;
      flex-direction: column;
      gap: var(--space-3xs);
      margin-top: var(--space-xs);

      .episode-swiper-title {
        color: black;
        font-family: var(--font-primary);
        font-size: var(--fs-0);
        font-weight: 500;
        line-height: 133%;
        letter-spacing: -0.03px;
      }
      .episode-swiper-subTitle {
        color: var(--dark-gray);
        font-family: var(--font-body);
        font-size: var(--fs--2);
        line-height: 160%;
      }
    }
  }
</style>
