---
import { cn } from "../../lib/helperFunctions";
import { useSanityImage } from "../../lib/sanity";
import type { SanityImageType } from "../../utils";

interface Props {
  src: SanityImageType | undefined;
  className?: string;
  captionClassName?: string;
}
const { src, className, captionClassName, ...props } = Astro.props || {};
const { caption, alt, hasCaption } = src || {};

const image = useSanityImage(src);
if (!image?.src) {
  return null;
}
---

{
  (() => {
    return hasCaption ? (
      <figure>
        <img
          src={image?.src}
          alt={alt || "Image"}
          class={cn(className)}
          {...props}
        />
        {caption && (
          <figcaption class={cn(captionClassName)}>{caption}</figcaption>
        )}
      </figure>
    ) : (
      <figure>
        <img
          src={image?.src}
          alt={alt || "Image"}
          class={cn(className)}
          {...props}
        />
      </figure>
    );
  })()
}
