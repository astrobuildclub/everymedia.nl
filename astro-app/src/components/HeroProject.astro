---
import { PortableText } from "astro-portabletext";
import type { HeroViewType } from "../utils";
import SanityImage from "./commons/SanityImage.astro";
import DownArrow from "./icons/downArrow";
import SimpleVideo from "./commons/SimpleVideo.astro";
import { stegaClean } from "@sanity/client/stega";

interface Props {
  data: HeroViewType;
}
const {
  title,
  subtitle,
  heroVideo,
  heroImage,
  select: Select,
  intro,
  client,
  tag,
  documentId,
  documentType,
} = Astro.props.data || {};
const select = stegaClean(Select || "");

console.log("heroVideo:", heroVideo);
console.log("heroImage:", heroImage);
---

{
  (() => {
    return (
      <section class="project-hero-section">
        <div class="container">
          <div class="project-hero-title">
            <div class="project-hero-title-inner">
              <div class="project-hero-categories">
                {client && <span class="categories-left">{client}</span>}
                {tag && <p class="categories-right">{tag}</p>}
              </div>
              {title && <h1 class="project-banner-title">{title}</h1>}
              <div class="desc-with-icon">
                {subtitle && <p class="project-banner-desc">{subtitle}</p>}
                <a href="#downArrow">
                  <DownArrow className="skip-icon" />
                </a>
              </div>
            </div>
            {intro && (
              <div class="banner-sub-desc">
                <PortableText value={intro} />
              </div>
            )}
          </div>
          {select === "heroVideo" && heroVideo && (
            <div class="project-bg">
              <SimpleVideo
                autoplay={true}
                loop={true}
                className=""
                videoUrl={heroVideo}
                documentId={documentId}
                documentType={documentType}
                sanityFieldName="heroVideo"
              />
            </div>
          )}
          {select === "heroImage" && heroImage && (
            <div class="project-bg">
              <SanityImage
                src={heroImage}
                className="sanity-image "
                documentId={documentId}
                documentType={documentType}
                sanityFieldName="heroImage"
              />
            </div>
          )}
        </div>
        <a href="#downArrow">
          <DownArrow className="skip-icon-mobie" />
        </a>
      </section>
    );
  })()
}
<style>
  .project-hero-section {
    position: relative;
    min-height: 100dvh;
    width: 100%;

    .container {
      .project-hero-title {
        padding: var(--space-s);
        display: grid;
        gap: var(--space-xl);
        grid-column-start: 1;
        position: absolute;
        bottom: 6.75rem;
        z-index: 2;
        left: 0;
        right: 0;

        @media (max-width: 767px) {
          gap: 1rem;
          bottom: 4.5rem;
        }

        .project-hero-title-inner {
          width: 100%;

          .project-hero-categories {
            display: flex;
            justify-content: space-between;
            align-items: center;

            .categories-left {
              color: #909090;
              font-family: var(--font-mono);
              font-size: 0.75rem;
              font-weight: 500;
              line-height: 150%;
              letter-spacing: 0.36px;
              text-transform: uppercase;
            }

            .categories-right {
              padding: var(--space-3xs) var(--space-2xs-xs);
              background-color: #00000099;
              backdrop-filter: blur(2px);
              border-radius: 999px;
              color: var(--Gray-50, #fff);
              font-family: var(--font-mono);
              font-size: 0.651rem;
              font-weight: 500;
              line-height: 100%;
              letter-spacing: 0.313px;
              text-transform: uppercase;
            }
          }

          .project-banner-title {
            font-size: var(---fs---1);
            color: white;
            font-weight: 800;
            line-height: 100%;
            text-transform: uppercase;
            font-family: var(--font-primary);
            max-width: 75rem;
          }

          .desc-with-icon {
            position: relative;

            .project-banner-desc {
              margin-top: 0.375rem;
              font-size: var(--fs-1);
              font-weight: 700;
              line-height: 120%;
              font-family: var(--font-heading);
              color: white;
            }

            .skip-icon {
              position: absolute;
              right: 4rem;
              bottom: -9rem;
              z-index: 2;
              cursor: pointer;

              @media (max-width: 767px) {
                display: none;
              }
            }
          }
        }

        .banner-sub-desc {
          color: white;
          font-weight: 500;
          line-height: 133%;
          letter-spacing: -0.03px;
          font-family: var(--font-primary);
          padding-left: 10%;
          max-width: 58.5rem;
          width: 100%;
          font-size: var(---fs---2);

          @media (max-width: 1279px) {
            padding-left: 0%;
          }
        }
      }

      .project-bg {
        position: absolute;
        top: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        overflow: hidden;

        &:after {
          content: "";
          position: absolute;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          background:
            linear-gradient(
              190deg,
              rgba(0, 0, 0, 0.05) 49.15%,
              rgba(0, 0, 0, 0.95) 92.46%
            ),
            lightgray 0% 0% / 25px 25px repeat;
          mix-blend-mode: multiply;
          z-index: 1;
        }

        video,
        figure {
          width: 100%;
          height: 100%;
          object-fit: cover;
        }

        figure {
          position: relative;
          z-index: 0;

          .sanity-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            position: relative;
            z-index: 0;
          }
        }
      }
    }

    .skip-icon-mobie {
      display: none;

      @media (max-width: 767px) {
        display: block;
        position: absolute;
        bottom: -1.5rem;
        right: 1.5rem;
        z-index: 5;
        cursor: pointer;
      }
    }
  }
</style>
