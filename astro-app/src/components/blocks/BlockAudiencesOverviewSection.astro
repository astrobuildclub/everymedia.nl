---
import { PortableText } from "astro-portabletext";
import type { BlockAudiencesOverviewSectionType } from "../../utils";
import AudiencesOverview from "../AudiencesOverview.astro";

interface Props {
  data: BlockAudiencesOverviewSectionType;
}
const { title, audiences } = Astro.props.data || {};
---

{
  () => {
    return (
      <section class="audiences-overview">
        {/* {title && (
          <div class="audiences-title">
            <PortableText value={title} />
          </div>
        )} */}

        <div id="sectionPin" class="section-pin">
          <div class="sticky-container">
            {audiences?.length > 0 && (
              <div class="pin-wrap card-container">
                {audiences?.map((item) => {
                  return <AudiencesOverview audience={item} />;
                })}
              </div>
            )}
          </div>
        </div>
      </section>
    );
  }
}

<style>
  .audiences-overview {
    min-height: 100dvh;
    color: var(--clr-secondary);
    background-color: black;

    .audiences-title {
      font-family: var(--font-primary);
      font-weight: bold;
      line-height: 112%;
      letter-spacing: -2%;
      text-transform: uppercase;
      color: var(--color-gray-50);
      font-size: var(--fs-4);
      padding-left: var(--space-xl);
      /* margin-bottom: 1.5rem; */

      @media (max-width: 767px) {
        margin-bottom: 0.5rem;
      }
    }

    #sectionPin {
      min-height: 100%;

      .sticky-container {
        min-height: 100dvh;
        height: 100dvh;
        width: 100%;
        position: sticky;
        top: 0;
        overflow-x: hidden;

        /* .card-container {
          min-height: 100%;
        } */
      }
    }
  }
</style>
