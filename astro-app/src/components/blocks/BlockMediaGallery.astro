---
import type { BlockMediaGalleryType, SanityImageType } from "../../utils";
import SanityImage from "../commons/SanityImage.astro";
import CarouselNav from "../commons/CarouselNav.astro";
import { getTranslation } from "../../i18n/translate";
import { defaultLanguage } from "../../lib/helperFunctions";

interface Props {
  data: BlockMediaGalleryType;
}

const { title, media, autoplay = false, _key } = Astro.props.data || {};
const locale = Astro.params?.locale || defaultLanguage.id;
const { t } = getTranslation(locale);
const headingId = `media-gallery-${_key || "title"}`;
const items = (media || []).filter(Boolean);
---

{
  items.length > 0 && (
    <section
      class="block-media-gallery-section"
      data-media-carousel
      data-carousel-root
      data-autoplay={autoplay ? "true" : "false"}
      data-first-slide-message={t("carouselFirstSlide")}
      data-last-slide-message={t("carouselLastSlide")}
      data-slide-label-message={t("carouselSlideLabel")}
      aria-roledescription="carousel"
      {...(title
        ? { "aria-labelledby": headingId }
        : { "aria-label": t("mediaGallery") })}
    >
      <div class="media-gallery-header">
        {title && (
          <h2 id={headingId} class="media-gallery-title">
            {title}
          </h2>
        )}
        {items.length > 1 && <CarouselNav autoplay={autoplay} />}
      </div>
      <div class="swiper">
        <div class="swiper-wrapper">
          {items.map((item: SanityImageType) => (
            <div class="swiper-slide media-gallery-image">
              <SanityImage src={item} />
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<script>
  import "swiper/css";
  import { initCarousels } from "../../lib/carousel";

  // Ook na navigatie met <ClientRouter /> (guard voorkomt dubbel starten).
  document.addEventListener("astro:page-load", () =>
    initCarousels("[data-media-carousel]", {
      slidesPerView: 1,
      spaceBetween: 16,
      breakpoints: {
        768: { slidesPerView: 2, spaceBetween: 24 },
      },
    })
  );
</script>

<style>
  .block-media-gallery-section {
    padding: var(--space-2xl) var(--space-s);
  }

  .media-gallery-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-s);
    margin-block-end: var(--space-s);

    /* Zonder titel staan de knoppen rechts. */
    &:not(:has(.media-gallery-title)) {
      justify-content: flex-end;
    }

    &:not(:has(*)) {
      display: none;
    }
  }

  .media-gallery-title {
    font-family: var(--font-primary);
    font-size: var(--fs-1);
    font-weight: 700;
    line-height: 112%;
  }

  .media-gallery-image {
    block-size: auto;

    :global(figure) {
      display: flex;
      flex-direction: column;
      gap: var(--space-2xs);
    }

    :global(img) {
      inline-size: 100%;
      aspect-ratio: 1;
      object-fit: cover;
      border-radius: 5px;
    }

    :global(figcaption) {
      font-size: var(--fs-caption);
      color: var(--gray-700);
      font-weight: 500;
      line-height: 150%;
      letter-spacing: 0.25px;
    }
  }
</style>
