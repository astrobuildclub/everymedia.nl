---
import type { BlockTextType } from "../../utils";
import RichTextSimple from "../commons/RichTextSimple/RichTextSimple.astro";

interface Props {
  data: BlockTextType;
}

const { title, hideTitle, content } = Astro.props.data || {};
const gridClass = hideTitle ? "single-column" : "two-column";
---

{
  (() => {
    return (
      <section class={`block-text-section ${gridClass}`}>
        {!hideTitle && title && <h2 class="block-text-title">{title}</h2>}
        {content && (
          <div class="block-text-content">
            <RichTextSimple value={content} />
          </div>
        )}
      </section>
    );
  })()
}

<style>
  .block-text-section {
    padding: var(--space-2xl) var(--space-s);
    display: grid;
    gap: var(--grid-gutter);
    @media (max-width: 767px) {
      gap: 1.125rem;
    }
  }

  .block-text-section.single-column {
    grid-template-columns: 1fr;
  }

  .block-text-section.two-column {
    grid-template-columns: 1fr 1fr;
    @media (max-width: 767px) {
      grid-template-columns: 1fr;
    }
  }

  .block-text-title {
    font-size: var(--fs-1);
    color: black;
    font-weight: 500;
    line-height: 120%;
    font-family: var(--font-primary);
  }

  .block-text-content {
    max-width: 43.5rem;
    margin: 0 auto;
    width: 100%;
  }
</style>
