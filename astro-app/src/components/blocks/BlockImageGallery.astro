---
import type { BlockImageGalleryType, SanityImageType } from "../../utils";
import SanityImage from "../commons/SanityImage.astro";
import CarouselNav from "../commons/CarouselNav.astro";
import { getTranslation } from "../../i18n/translate";
import { defaultLanguage } from "../../lib/helperFunctions";

interface Props {
  data: BlockImageGalleryType;
}
const { images } = Astro.props.data || {};
const locale = Astro.params?.locale || defaultLanguage.id;
const { t } = getTranslation(locale);
const items = (images || []).filter(Boolean);
---

{
  items.length > 0 && (
    <section
      class="image-gallery-carousel"
      data-image-gallery-carousel
      data-carousel-root
      data-autoplay="false"
      data-first-slide-message={t("carouselFirstSlide")}
      data-last-slide-message={t("carouselLastSlide")}
      data-slide-label-message={t("carouselSlideLabel")}
      aria-roledescription="carousel"
      aria-label={t("mediaGallery")}
    >
      {items.length > 1 && <CarouselNav class="image-gallery-nav" />}
      <div class="swiper">
        <div class="swiper-wrapper">
          {items.map((item: SanityImageType) => (
            <div class="swiper-slide">
              <SanityImage src={item} className="swiper-image" />
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<script>
  import "swiper/css";
  import { initCarousels } from "../../lib/carousel";

  initCarousels("[data-image-gallery-carousel]", {
    slidesPerView: "auto",
    spaceBetween: 30,
  });
</script>

<style>
  .image-gallery-carousel {
    padding: var(--space-xl-2xl) var(--space-s);
    padding-right: 0;

    @media (max-width: 767px) {
      padding-right: var(--space-s);
    }

    :global(.image-gallery-nav) {
      padding-inline-end: var(--space-s);
      margin-block-end: var(--space-s);
    }

    .swiper-wrapper {
      align-items: flex-start;
      padding-left: 0;
      .swiper-slide {
        width: 696px !important;
        @media (max-width: 767px) {
          /* aspect-ratio: 4 / 3; */
          width: 100% !important;
        }
        :global(figure) {
          :global(.swiper-image) {
            width: 696px;
            height: auto;
            border-radius: 5px;
            object-fit: cover;
            @media (max-width: 767px) {
              /* aspect-ratio: 4 / 3; */
              width: 100%;
            }
          }
        }
      }
    }
  }
</style>
