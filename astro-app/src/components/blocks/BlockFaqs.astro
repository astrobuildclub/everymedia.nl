---
import { PortableText } from "astro-portabletext";
import type { BlockFaqsType, FaqType } from "../../utils";
import { PlusCircle } from "../icons/plusCircle";
import { MinusCircle } from "../icons/minusCircle";

interface Props {
  data: BlockFaqsType;
}
const { title, faqs } = Astro.props.data || {};
---

{
  (() => {
    return (
      <section class="faq-section">
        {title && <h2 class="faq-title">{title}</h2>}
        {faqs?.length > 0 && (
          <ul class="faq-list">
            {faqs?.map((item: FaqType, index: number) => {
              const { question, answer } = item || {};
              const isOpen = index === 0; // open first item
              return (
                <li
                  class={`faq-item ${isOpen ? "faq-item-active" : ""}`}
                  id={`faq-item-${index}`}
                >
                  <h3 class="faq-heading">
                    <button
                      class="faq-question"
                      data-index={index}
                      aria-expanded={isOpen ? "true" : "false"}
                      aria-controls={answer ? `faq-answer-${index}` : undefined}
                    >
                      <span
                        class={`faq-question-title ${
                          isOpen ? "faq-question-title-active" : ""
                        }`}
                      >
                        {question}
                      </span>
                      <span
                        class="faq-icon open"
                        data-index={index}
                        aria-hidden="true"
                        style={
                          isOpen ? "display: none;" : "display: inline-block;"
                        }
                      >
                        <PlusCircle />
                      </span>
                      <span
                        class="faq-icon close"
                        data-index={index}
                        aria-hidden="true"
                        style={
                          isOpen ? "display: inline-block;" : "display: none;"
                        }
                      >
                        <MinusCircle />
                      </span>
                    </button>
                  </h3>
                  {answer && (
                    <div
                      id={`faq-answer-${index}`}
                      class={`faq-answer ${isOpen ? "open" : ""}`}
                      style={isOpen ? "height: auto;" : ""}
                    >
                      <div class="faq-answer-inner">
                        <PortableText value={answer} />
                      </div>
                    </div>
                  )}
                </li>
              );
            })}
          </ul>
        )}
      </section>
    );
  })()
}

<script>
  // astro:page-load: ook na navigatie met <ClientRouter />.
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>(".faq-question").forEach((button) => {
      if (button.dataset.faqReady === "true") return;
      button.dataset.faqReady = "true";
      button.addEventListener("click", (event) => {
        const target = event.currentTarget as HTMLButtonElement;
        const index = target?.getAttribute("data-index");
        const answer = document.getElementById(
          `faq-answer-${index}`
        ) as HTMLElement;
        const plusIcon = target.querySelector(".open") as HTMLElement;
        const minusIcon = target?.querySelector(".close") as HTMLElement;
        const parentItem = target.closest(".faq-item") as HTMLElement;
        const questionTitle = target.querySelector(".faq-question-title");

        document.querySelectorAll(".faq-answer.open").forEach((openAnswer) => {
          if (openAnswer !== answer) {
            const openPlusIcon =
              openAnswer.previousElementSibling?.querySelector(".open");
            const openMinusIcon =
              openAnswer.previousElementSibling?.querySelector(".close");
            const openItem = openAnswer.closest(".faq-item");
            const openQuestionTitle =
              openAnswer.previousElementSibling?.querySelector(
                ".faq-question-title"
              );

            (openAnswer as HTMLElement).style.height = "0px";
            openAnswer.classList.remove("open");
            openItem
              ?.querySelector(".faq-question")
              ?.setAttribute("aria-expanded", "false");

            if (openPlusIcon)
              (openPlusIcon as HTMLElement).style.display = "inline-block";
            if (openMinusIcon)
              (openMinusIcon as HTMLElement).style.display = "none";
            if (openItem) openItem.classList.remove("faq-item-active");
            if (openQuestionTitle)
              openQuestionTitle.classList.remove("faq-question-title-active");
          }
        });

        if (answer.classList.contains("open")) {
          answer.style.height = answer.scrollHeight + "px";
          setTimeout(() => {
            answer.style.height = "0px";
          }, 10);
          setTimeout(() => answer.classList.remove("open"), 300);

          plusIcon.style.display = "inline-block";
          minusIcon.style.display = "none";
          target.setAttribute("aria-expanded", "false");
          parentItem?.classList.remove("faq-item-active");
          questionTitle?.classList.remove("faq-question-title-active");
        } else {
          answer.classList.add("open");
          answer.style.height = "auto";
          let height = answer.scrollHeight + "px";
          answer.style.height = "0px";
          setTimeout(() => {
            answer.style.height = height;
          }, 10);

          plusIcon.style.display = "none";
          minusIcon.style.display = "inline-block";
          target.setAttribute("aria-expanded", "true");
          parentItem?.classList.add("faq-item-active");
          questionTitle?.classList.add("faq-question-title-active");
        }
      });
    });
  });
</script>

<style>
  .faq-section {
    padding: var(--space-xl-2xl) var(--space-s);
    display: grid;
    gap: var(--grid-gutter);
  }

  .faq-title {
    font-size: 0.75rem;
    color: var(--gray-700);
    font-weight: 500;
    line-height: 150%;
    letter-spacing: 0.36px;
    text-transform: uppercase;
    font-family: var(--font-mono);
  }

  .faq-list {
    border: 1px solid black;
    padding-left: 0;
    margin: 0;
  }

  /* De padding zit in de knop, zodat de hele rij klikbaar is. */
  .faq-item {
    border-bottom: 1px solid black;
  }

  .faq-heading {
    margin: 0;
  }

  .faq-item:nth-last-child(1) {
    border: none;
  }

  .faq-item-active {
    background-color: black;
    color: white;
  }

  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: transparent;
    gap: var(--space-s);
    border: none;
    width: 100%;
    padding: var(--space-s-m);
    cursor: pointer;
    color: inherit;
    font: inherit;

    &:focus-visible {
      outline: 2px solid currentColor;
      outline-offset: -4px;
    }
  }

  .faq-item:not(.faq-item-active) .faq-question:hover .faq-question-title {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .faq-question-title {
    font-size: var(--fs--1);
    color: var(--dark-gray);
    font-weight: 700;
    line-height: 120%;
    font-family: var(--font-body);
    text-align: left;
  }

  .faq-question-title-active {
    color: white;
  }

  .faq-icon.open {
    display: inline-block;
  }

  .faq-icon.close {
    display: none;
  }

  .faq-answer {
    height: 0;
    overflow: hidden;
    transition: height 0.3s ease-in-out;
    color: white;
    font-family: var(--font-body);
    line-height: 133%;
    font-size: var(--fs--1);
    transition: all 0.2s ease-in-out;
    text-align: left;
  }

  /* Padding op de binnenkant: de buitenkant animeert van hoogte 0. */
  .faq-answer-inner {
    padding: 0 var(--space-s-m) var(--space-s-m);
  }
</style>
