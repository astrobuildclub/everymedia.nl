---
import { PortableText } from "astro-portabletext";
import type { BlockFeetSectionType, ButtonType } from "../../utils";
import ProjectGridHomepage from "../ProjectGridHomepage.astro";
import SanityButton from "../commons/SanityButton.astro";
import { cn } from "../../lib/helperFunctions";

interface Props {
  data: BlockFeetSectionType;
}
const {
  title,
  body,
  connectWithUs = [],
  subTitle,
  allProjects = [],
} = Astro.props.data || {};
const cta: ButtonType = {
  _type: "cta",
  variant: "black",
  buttonText: "meer werk",
};
---

<section>
  <div class="block-feet-section">
    {
      title && (
        <div class="title-container">
          <div class="sticky-title">
            <div class="title">
              <PortableText value={title} />
            </div>
          </div>
        </div>
      )
    }

    <div class="media-header">
      <p>{`Media`}</p>
    </div>

    {
      connectWithUs?.length > 0 && (
        <div class="connect-section">
          {connectWithUs?.map((item) => (
            <div
              class={cn(
                "",
                item?.select === "body"
                  ? "connect-item full-span"
                  : "connect-item half-span"
              )}
            >
              {item?.title && (
                <div>
                  <div class="connect-title">{item?.title}</div>
                  {item?.select === "body" && item?.body && (
                    <div class="connect-body">
                      <PortableText value={item?.body} />
                    </div>
                  )}
                  {item?.select === "labelLinks" &&
                    item?.labelLinks?.length > 0 && (
                      <ul class="label-links">
                        {item?.labelLinks?.map((item) => (
                          <li>{item?.label}</li>
                        ))}
                      </ul>
                    )}
                </div>
              )}
            </div>
          ))}
        </div>
      )
    }

    <div class="content">
      <div class="content-box">
        {
          subTitle && (
            <div class="sub-title">
              <PortableText value={subTitle} />
            </div>
          )
        }
        {
          body && (
            <div class="body-text">
              <PortableText value={body} />
            </div>
          )
        }
      </div>

      {
        allProjects?.length > 0 && (
          <div class="projects">
            <ProjectGridHomepage projects={allProjects} />
          </div>
        )
      }

      {
        cta?.buttonText && (
          <div class="cta-button">
            <SanityButton block={cta} className="button" />
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  section {
    margin-top: calc(-1 * var(--type-pos));

    .block-feet-section {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      position: relative;

      .title-container {
        grid-row: span 2;
        padding-left: var(--space-3xs);
        padding-right: var(--space-3xs);

        .sticky-title {
          position: sticky;
          top: -1.5rem;

          .title {
            font-size: var(--type-size);
            color: var(--charcoal-gray);
            font-weight: bold;
            font-family: var(--font-heading);
            text-transform: uppercase;
            line-height: 100%;
          }
        }
      }

      .media-header {
        grid-column-start: 2;
        grid-row: span 1;
        grid-row-start: 1;

        p {
          font-size: var(--type-size);
          font-weight: bold;
          color: var(--charcoal-gray);
          font-family: var(--font-heading);
          text-transform: uppercase;
          line-height: 100%;
          padding-left: var(--space-3xs);
          padding-right: var(--space-3xs);
          visibility: hidden;
        }
      }

      .connect-section {
        grid-column: span 1 / span 1;
        grid-row-start: 3;
        position: sticky;
        bottom: 0;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        z-index: -1;
        gap: var(--space-xs);
        padding: var(--space-xs);
        padding-bottom: 4.5rem;

        @media (max-width: 767px) {
          grid-template-columns: repeat(2, 1fr);
          padding-bottom: 0rem;
          grid-column: span 1 / span 1;
          grid-row: span 1 / span 1;
        }

        .connect-item {
          &.full-span {
            grid-column: span 2;

            @media (max-width: 767px) {
              grid-column: span 4;
            }
          }

          &.half-span {
            grid-column: span 1;

            @media (max-width: 767px) {
              grid-column: span 2;
            }
          }

          .connect-title {
            font-size: 0.75rem;
            color: #666;
            font-weight: medium;
            text-transform: uppercase;
            letter-spacing: 3%;
            font-family: var(--font-mono);
            margin-bottom: 0.5rem;
          }

          .connect-body {
            font-size: var(--fs--2);
            line-height: 150%;
            color: var(--dim-gray);
            font-family: var(--font-body);
          }

          .label-links {
            font-size: var(--fs--2);
            line-height: var(--leading-tight);
            font-weight: medium;
            margin: 0;
            padding: 0;

            li {
              font-size: var(--fs--2);
              line-height: 150%;
              color: var(--dim-gray);
              font-family: var(--font-primary);
            }
          }
        }
      }

      .content {
        grid-column: span 1;
        grid-row: span 2;
        display: grid;
        padding: var(--space-xs);
        padding-top: var(--space-s);
        padding-bottom: 4.5rem;

        @media (min-width: 767px) {
          padding-bottom: 6rem;
        }

        .content-box {
          display: flex;
          flex-direction: column;
          gap: 1.125rem;
          margin-bottom: 2.25rem;

          .sub-title {
            & {
              font-size: var(--fs-0);
              line-height: 133%;
              color: var(--neutrals-black);
              font-weight: 500;
            }
          }

          .body-text {
            font-size: var(--fs--1);
            line-height: 133%;
            font-weight: normal;
            color: var(--neutrals-black);
          }
        }

        .projects {
        }

        .cta-button {
          .button {
            border-radius: 9999px;
          }
        }
      }
    }

    @media (max-width: 767px) {
      .block-feet-section {
        grid-template-columns: 1fr;
        gap: var(--space-xs);

        .title-container {
          display: none;
        }

        .media-header {
          grid-column: 1;
          grid-row: unset;
          text-align: center;
        }

        .connect-section {
          display: none;
        }

        .content {
          grid-column: 1;
          grid-row: unset;
        }
      }
    }
  }
</style>
