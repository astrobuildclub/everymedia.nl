---
import { PortableText } from "astro-portabletext";
import type { BlockFeetSectionType } from "../../utils";
import ProjectGridHomepage from "../ProjectGridHomepage.astro";
import SanityButton from "../commons/SanityButton.astro";
import { cn } from "../../lib/helperFunctions";
import SanityLink from "../commons/SanityLink.astro";

interface Props {
  data: BlockFeetSectionType;
}
const {
  title,
  intro,
  body,
  connectWithUs = [],
  subtitle,
  selectedProjects = [],
  cta,
} = Astro.props.data || {};
---

{
  (() => {
    return (
      <section>
        <div class="block-feet-section">
          {title && (
            <div class="title-container">
              <div class="sticky-title">
                <div class="title">{title}</div>
              </div>
            </div>
          )}

          {subtitle && (
            <div class="media-header">
              <p>{subtitle}</p>
            </div>
          )}

          {connectWithUs?.length > 0 && (
            <div class="connect-section">
              {connectWithUs?.map((item) => {
                const { body, title, select, labelLinks } = item || {};
                return (
                  <div
                    class={cn(
                      "",
                      select === "body"
                        ? "connect-item full-span"
                        : "connect-item half-span"
                    )}
                  >
                    <div>
                      {title && <div class="connect-title">{title}</div>}
                      {select === "body" && body && (
                        <div class="connect-body">
                          <PortableText value={body} />
                        </div>
                      )}
                      {select === "labelLinks" && labelLinks?.length > 0 && (
                        <ul class="label-links">
                          {labelLinks?.map((item) => {
                            const { link, label } = item || {};
                            return (
                              <li>
                                <SanityLink href={link} class="label-link">{label}</SanityLink>
                              </li>
                            );
                          })}
                        </ul>
                      )}
                    </div>
                  </div>
                );
              })}
            </div>
          )}
          <div class="content">
            <div class="content-box">
              {intro && (
                <div class="sub-title">
                  <PortableText value={intro} />
                </div>
              )}
              {body && (
                <div class="body-text">
                  <PortableText value={body} />
                </div>
              )}
            </div>
            {selectedProjects?.length > 0 && (
              <div class="projects">
                <ProjectGridHomepage projects={selectedProjects} />
              </div>
            )}

            {cta?.buttonText && (
              <div class="cta-button">
                <SanityButton block={cta} class="button" />
              </div>
            )}
          </div>
        </div>
      </section>
    );
  })()
}

<style>
  section {
    margin-top: calc(-1 * var(--type-pos));

    .block-feet-section {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      position: relative;

      .title-container {
        grid-row: span 2;
        padding-left: var(--space-3xs);
        padding-right: var(--space-3xs);

        .sticky-title {
          position: sticky;
          top: -1.5rem;

          .title {
            font-size: var(--type-size);
            color: var(--charcoal-gray);
            font-weight: bold;
            font-family: var(--font-heading);
            text-transform: uppercase;
            line-height: 100%;
          }
        }
      }

      .media-header {
        grid-column-start: 2;
        grid-row: span 1;
        grid-row-start: 1;

        p {
          font-size: var(--type-size);
          font-weight: bold;
          color: var(--charcoal-gray);
          font-family: var(--font-heading);
          text-transform: uppercase;
          line-height: 100%;
          padding-left: var(--space-3xs);
          padding-right: var(--space-3xs);
          visibility: hidden;
        }
      }

      .connect-section {
        grid-column: span 1 / span 1;
        grid-row-start: 3;
        position: sticky;
        bottom: 0;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        z-index: -1;
        gap: var(--space-xs);
        padding: var(--space-xs);
        padding-bottom: 4.5rem;

        @media (max-width: 767px) {
          grid-template-columns: repeat(2, 1fr);
          padding-bottom: 0rem;
          grid-column: span 1 / span 1;
          grid-row: span 1 / span 1;
        }

        .connect-item {
          &.full-span {
            grid-column: span 2;

            @media (max-width: 767px) {
              grid-column: span 4;
            }
          }

          &.half-span {
            grid-column: span 1;

            @media (max-width: 767px) {
              grid-column: span 2;
            }
          }

          .connect-title {
            font-size: 0.75rem;
            color: var(--neutrals-600);
            font-weight: medium;
            text-transform: uppercase;
            letter-spacing: 3%;
            font-family: var(--font-mono);
            margin-bottom: 0.5rem;
          }

          .connect-body {
            font-size: var(--fs--2);
            line-height: 150%;
            color: var(--dim-gray);
            font-family: var(--font-body);
          }

          .label-links {
            font-size: var(--fs--2);
            line-height: var(--leading-tight);
            font-weight: medium;
            margin: 0;
            padding: 0;

            .label-link {
              font-size: var(--fs--2);
              line-height: 150%;
              color: var(--dim-gray);
              font-family: var(--font-primary);
              text-decoration: none;
            }
          }
        }
      }

      .content {
        grid-column: span 1;
        grid-row: span 2;
        display: grid;
        padding: var(--space-xs);
        padding-top: var(--space-s);
        padding-bottom: 4.5rem;

        @media (min-width: 767px) {
          padding-bottom: 6rem;
        }

        .content-box {
          display: flex;
          flex-direction: column;
          gap: 1.125rem;
          margin-bottom: 2.25rem;

          .sub-title {
            & {
              font-size: var(--fs-0);
              line-height: 133%;
              color: var(--neutrals-black);
              font-weight: 500;
            }
          }

          .body-text {
            font-size: var(--fs--1);
            line-height: 133%;
            font-weight: normal;
            color: var(--neutrals-black);
          }
        }

        .projects {
        }

        .cta-button {
          .button {
            border-radius: 9999px;
          }
        }
      }
    }

    @media (max-width: 767px) {
      .block-feet-section {
        grid-template-columns: 1fr;
        gap: var(--space-xs);

        .title-container {
          display: none;
        }

        .media-header {
          grid-column: 1;
          grid-row: unset;
          text-align: center;
        }

        .connect-section {
          display: none;
        }

        .content {
          grid-column: 1;
          grid-row: unset;
        }
      }
    }
  }
</style>
