---
import { stegaClean } from "@sanity/client/stega";
import { cn } from "../../lib/helperFunctions";
import type { BlockMultiColType, BlockTextType, BlockTextMediaType } from "../../utils";
import RichTextSimple from "../commons/RichTextSimple/RichTextSimple.astro";
import BlockMediaGallery from "./BlockMediaGallery.astro";
import BlockTextMedia from "./BlockTextMedia.astro";

interface Props {
  data: BlockMultiColType;
}
const {
  colsAmount,
  blockMediaGallery,
  blockText,
  blockTextMedia,
  select: Select,
} = Astro.props.data || {};
const select = stegaClean(Select || "");

const gridStyle = {
  gridTemplateColumns: `repeat(${colsAmount}, 1fr)`,
};
---

{
  (() => {
    return (
      <section class="multi-col-section">
        {select === "blockText" && blockText?.length > 0 && (
          <div class={cn("multi-col-cards-grid")} style={gridStyle}>
            {blockText?.map((item: BlockTextType) => {
              const { title, hideTitle, content } = item || {};
              const gridClass = hideTitle
                ? "single-column"
                : cn(
                    "two-column",
                    blockText?.length > 1 ? "grid-one-fr" : "grid-two-fr"
                  );
              return (
                <section class={`block-text-section ${gridClass}`}>
                  {!hideTitle && title && (
                    <h2 class="block-text-title">{title}</h2>
                  )}
                  {content && (
                    <div class="block-text-content">
                      <RichTextSimple value={content} />
                    </div>
                  )}
                </section>
              );
            })}
          </div>
        )}
        {select === "blockTextMedia" && blockTextMedia?.length > 0 && (
          <div>
            {blockTextMedia?.map((item: BlockTextMediaType) => {
              return (
                <div>
                  <BlockTextMedia data={item} />
                </div>
              );
            })}
          </div>
        )}
        {select === "blockMediaGallery" && blockMediaGallery && (
          <div>
            <BlockMediaGallery data={blockMediaGallery} />
          </div>
        )}
      </section>
    );
  })()
}

<style>
  .multi-col-cards-grid {
    display: grid;
    gap: var(--grid-gutter);
    padding: var(--space-2xl) var(--space-s);
    @media (max-width: 767px) {
      grid-template-columns: 1fr !important;
    }
  }

  .block-text-section {
    display: grid;
    gap: var(--grid-gutter);
    @media (max-width: 767px) {
      gap: 1.125rem;
    }
  }
  
  .block-text-section.single-column {
    grid-template-columns: 1fr;
  }

  .block-text-section.two-column {
    @media (max-width: 767px) {
      grid-template-columns: 1fr;
    }
  }
  .block-text-section.two-column.grid-one-fr {
    grid-template-columns: 1fr;
    gap: 1rem;
    height: fit-content;
  }
  .block-text-section.two-column.grid-two-fr {
    grid-template-columns: 1fr 1fr;
    @media (max-width: 767px) {
      grid-template-columns: 1fr;
    }
  }

  .block-text-title {
    font-size: var(--fs-1);
    color: black;
    font-weight: 500;
    line-height: 120%;
    font-family: var(--font-primary);
  }

  .block-text-content {
    width: 100%;
  }
</style>
