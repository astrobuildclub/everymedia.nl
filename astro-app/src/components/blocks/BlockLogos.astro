---
import type { BlockLogosType } from "../../utils";
import SanityImage from "../commons/SanityImage.astro";

interface Props {
  data: BlockLogosType;
}

const { title, logos } = Astro.props.data || {};
---

{
  (() => {
    return (
      <section class="logos-section">
        {title && <h2 class="logos-title">{title}</h2>}
        {logos?.length > 0 && (
          <ul class="logos-list">
            {logos?.map((item) => {
              return (
                <li class="logos-box">
                  <SanityImage src={item} className="logos-image" />
                </li>
              );
            })}
          </ul>
        )}
      </section>
    );
  })()
}

<style>
  .logos-section {
    padding: var(--space-2xl) var(--space-s);
    @media (max-width: 639px) {
       padding-left: 0;
       padding-right: 0;
    }

    .logos-title {
      color: var(--gray-700);
      font-weight: 500;
      font-size: 0.75rem;
      font-family: var(--font-mono);
      line-height: 150%;
      letter-spacing: 0.36px;
      text-transform: uppercase;
    }
    .logos-list{
       display: flex;
       justify-content: center;
       align-items: center;
       gap: 2.5rem;
       margin: 0;
       padding-left: 0;
       overflow-x: auto;
       width: auto;
       margin: 0 auto;

      &::-webkit-scrollbar{
         display: none;
      }

       @media (max-width: 767px) {
        justify-content: space-between;
    }
        
        .logos-box{
             figure{
              aspect-ratio: 16 / 9;
                .logos-image{
                  width: 10rem;
                  height: 5.625rem;
                }
             }
        }
    }

  }
</style>
