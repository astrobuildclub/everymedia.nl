---
import type { BlockTeamMembersType } from "../../utils";
import SanityImage from "../commons/SanityImage.astro";

interface Props {
  data: BlockTeamMembersType;
}
const { title, teamMembers = [], footnote } = Astro.props.data || {};
---

{
  (() => {
    return (
      <section class="team-member-section">
        {title && <span class="team-member-title">{title}</span>}

        {teamMembers?.length > 0 && teamMembers?.length > 0 && (
          <div class="team-group">
            {teamMembers?.map((item) => {
              const { name, image, role } = item || {};
              return (
                <div class="team-card">
                  {image && (
                    <div class="team-image">
                      <SanityImage src={image} className="team-box-image" />
                    </div>
                  )}

                  <div class="team-about">
                    {name && <h3 class="team-name">{name}</h3>}
                    {role && <p class="team-role">{role}</p>}
                  </div>
                </div>
              );
            })}
          </div>
        )}
        <div class="">{footnote && <p class="bottom-text">{footnote}</p>}</div>
      </section>
    );
  })()
}

<style>
  .team-member-section {
    padding: var(--space-2xl-3xl) var(--space-s);
    background-color: var(--rich-black);
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;

    .team-member-title {
      font-size: 0.75rem;
      color: #bababa;
      font-weight: 500;
      line-height: 100%;
      letter-spacing: 0.36px;
      text-transform: uppercase;
    }

    .team-group {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.5rem;

      @media (max-width: 1023px) {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
      @media (max-width: 767px) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      @media (max-width: 479px) {
        grid-template-columns: repeat(1, minmax(0, 1fr));
      }

      .team-card {
        background-color: #171717;
        border-top-left-radius: 1rem;
        border-top-right-radius: 1rem;
        display: flex;
        flex-direction: column;
        /* align-items: center; */
        gap: var(--space-xs);

        .team-image {
          background-color: #171717;
          figure {
            height: 100%;
            .team-box-image {
              width: 100%;
              max-width: 100%;
              height: 229px;
              border-top-left-radius: 1rem;
              border-top-right-radius: 1rem;
              object-fit: cover;
              object-position: top;
            }
          }
        }

        .team-about {
          display: flex;
          flex-direction: column;
          gap: var(--space-3xs);
          box-shadow: 0px -36px var(--space-xl-2xl) 0px #171717;
          padding: var(--space-s);

          .team-name {
            color: #ebebeb;
            font-family: var(--font-body);
            font-size: var(--fs--1);
            font-weight: 700;
            line-height: 120%;
            text-align: left;
            text-transform: capitalize;
          }

          .team-role {
            color: #898989;
            font-family: var(--font-body);
            font-size: var(--fs--2);
            font-weight: 400;
            line-height: 150%;
            text-align: left;
            text-transform: capitalize;
          }
        }
      }
    }

    .bottom-text {
      color: #d2d2d2;
      font-family: var(--font-body);
      font-size: var(--fs--1);
      font-weight: 700;
      line-height: 120%;
    }
  }
</style>
