---
import { PortableText } from "astro-portabletext";
import type { BlockContactType } from "../../utils";
import SanityImage from "../commons/SanityImage.astro";
import SanityButton from "../commons/SanityButton.astro";

interface Props {
  data: BlockContactType;
}
const { title, cta, image, intro } = Astro.props.data || {};
---

<section class="section">
  <div class="grid-container">
    <div class="image-container">
      <SanityImage
        src={image}
        className="rounded-4xl w-full h-full object-cover"
      />
    </div>
    <div class="rightside-content">
      {title && <h2 class="title">{title}</h2>}
      {
        intro && (
          <div class="intro">
            <PortableText value={intro} />
          </div>
        )
      }
      {
        cta?.length > 0 && (
          <ul class="cta-list">
            {cta?.map((i) => (
              <li>
                <SanityButton block={i} />
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</section>

<style>
  .section {
    min-height: 100svh;
    padding: var(--space-s);
    padding-top: 8rem;
    padding-bottom: 6rem;

    .grid-container {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      align-items: center;
      justify-content: center;
      gap: 1.5rem;

      @media (max-width: 767px) {
        grid-template-columns: 1fr;
      }

      .image-container {
        border-radius: 2rem;
        width: 100%;

        img {
          border-radius: 2rem;
          width: 100%;
          height: 100%;
          object-fit: cover;
        }
      }

      .rightside-content {
        padding: 4.5rem;

        @media (max-width: 1023px) {
          padding: 2rem;
        }
        
        @media (max-width: 767px) {
          padding: 0rem;
        }

        .title {
          font-size: var(--fs-4);
          line-height: 112%;
          letter-spacing: -2%;
          text-transform: uppercase;
          font-weight: 700;
          color: var(--off-black);
          font-family: var(--font-heading);
          margin-bottom: 1.5rem;
        }

        .intro {
          line-height: 150%;
          font-weight: normal;
          letter-spacing: 0.016rem;
          color: black;
          font-size: small;
          font-family: var(--font-primary);
          display: flex;
          flex-direction: column;
          gap: 1.125rem;

          p {
            strong {
              font-family: var(--font-body);
              font-size: var(--fs-1);
              line-height: 120%;
              font-weight: 700;
            }
          }
        }

        .cta-list {
          margin-top: 1.5rem;
          display: flex;
          gap: 0.5rem;
          flex-wrap: wrap;
          padding-left: 0;

          li {
            list-style: none;
              a{
                 text-decoration: none;
              }
          }
        }
      }
    }
  }
</style>
