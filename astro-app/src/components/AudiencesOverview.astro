---
import { PortableText } from "astro-portabletext";
import SanityImage from "./commons/SanityImage.astro";
import type { AudienceType } from "../utils/sanity/types/audienceType";
import type { ButtonType } from "../utils";
import SanityButton from "./commons/SanityButton.astro";

interface Props {
  audiences: AudienceType[];
}
const { audiences = [] } = Astro.props || {};
const cta: ButtonType = {
  _type: "cta",
  variant: "white",
  buttonText: "Lees meer",
};
---

{
  (() => {
    return (
      <div id="sectionPin" class="section-pin">
        <div class="sticky-container">
          {audiences?.length > 0 && (
            <div class="pin-wrap card-container">
              {audiences?.map((item) => {
                const { title, intro, heroImage, select, heroVideo } =
                  item || {};
                return (
                  <article class="audience">
                    <div class="content-wrapper">
                      {title && <h3 class="title">{title}</h3>}
                      {intro && (
                        <div class="intro">
                          <PortableText value={intro} />
                        </div>
                      )}
                      {cta?.buttonText && (
                        <div>
                          <SanityButton block={cta} />
                        </div>
                      )}
                    </div>

                    {select === "heroImage" && heroImage && (
                      <SanityImage src={heroImage} className="image" />
                    )}
                    {select === "heroVideo" && heroVideo && (
                      <video
                        class="video"
                        autoplay
                        loop
                        playsinline
                        muted
                        preload="auto"
                        poster="https://picsum.photos/696/391"
                      >
                        <source src={heroVideo} type="video/mp4" />
                        {`Your browser does not support the video tag.`}
                      </video>
                    )}
                  </article>
                );
              })}
            </div>
          )}
        </div>
      </div>
    );
  })()
}

<style>
  #sectionPin {
    min-height: 100%;

    .sticky-container {
      min-height: 100dvh;
      height: 100vh;
      width: 100vw;
      position: sticky;
      top: 0;
      overflow-x: hidden;
      .card-container {
        padding-left: var(--space-xs) !important;
        padding-top: 0 !important;
        min-height: 100%;

        .audience {
          border-radius: var(--space-2xs);
          overflow: hidden;
          min-height: 90svh;
          height: 100%;
          position: relative;
          top: var(--space-xs);
          min-width: calc(100vmax - var(--margin) * 2);
          width: calc(100vmax - var(--margin) * 2);

          @media (min-width: 767px) {
            min-height: 50vh;
          }

          .content-wrapper {
            padding: 1.688rem;
            border-radius: 0.375rem;
            background: #0006;
            backdrop-filter: blur(40px);
            position: absolute;
            inset-inline: calc(var(--spacing) * 9);
            bottom: calc(var(--spacing) * 9);
            z-index: 2;
            display: flex;
            flex-direction: column;
            align-items: flex-start;

            @media (min-width: 767px) {
              max-width: 50%;
              padding: 2.25rem;
            }

            h3 {
              font-family: var(--font-primary);
              font-size: 1.5rem;
              font-weight: 600;
              margin-bottom: 0.75rem;
              line-height: 112%;
              color: var(--color-gray-50);
            }

            .intro {
              font-size: var(--fs--2);
              line-height: 150%;
              margin-bottom: 1.5rem;
              color: var(--color-gray-50);
              font-weight: 500;
              letter-spacing: 0.016rem;
              font-family: var(--font-primary);
            }
          }

          figure {
            width: 100%;
            height: 100%;
            .image{
              object-fit: cover;
              z-index: 1;
              width: 100%;
              height: 100%;
            }
          }

          .video {
            autoplay: true;
            loop: true;
            playsinline: true;
            muted: true;
            preload: auto;
            width: 100%;
              height: 100%;
              object-fit: cover;
          }
        }
      }
    }
  }
</style>
