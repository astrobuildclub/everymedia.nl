---
import { PortableText } from "astro-portabletext";
import SanityImage from "./commons/SanityImage.astro";
import type { AudienceType } from "../utils/sanity/types/audienceType";
import { buttonVariants } from "./commons/SanityButton.astro";
import SimpleVideo from "./commons/SimpleVideo.astro";
import SanityLink from "./commons/SanityLink.astro";
import { routes } from "../lib/router";
import { getTranslation } from "../i18n/translate";
import { cn, defaultLanguage } from "../lib/helperFunctions";
import { stegaClean } from "@sanity/client/stega";

interface Props {
  audience: AudienceType;
}

const {
  title,
  intro,
  heroImage,
  heroVideo,
  slug,
  _id,
  _type,
  select: Select,
} = Astro.props.audience || {};
const locale = Astro.params?.locale || defaultLanguage.id;
const { t } = getTranslation(locale);
const variantClasses = buttonVariants["white"] || "";
const select = stegaClean(Select || "");
---

{
  (() => {
    return (
      <article class="audience">
        <div class="content-wrapper">
          {title && (
            <SanityLink
              href={
                typeof slug === "object" && slug?.current
                  ? routes?.audience({
                      language: locale ?? "",
                      slug: slug?.current,
                    })
                  : "#"
              }
              class="content-title-link"
            >
              <h3 class="title">{title}</h3>
            </SanityLink>
          )}
          {intro && (
            <div class="intro">
              <PortableText value={intro} />
            </div>
          )}
          {title && (
            <div>
              <SanityLink
                href={
                  typeof slug === "object" && slug?.current
                    ? routes?.audience({
                        language: locale ?? "",
                        slug: slug?.current,
                      })
                    : "#"
                }
                class={cn(variantClasses, "audience-btn")}
              >
                <span>{t("readmore")}</span>
              </SanityLink>
            </div>
          )}
        </div>

        {select === "heroImage" && heroImage && (
          <SanityImage
            src={heroImage}
            className="image"
            documentId={_id}
            documentType={_type}
            sanityFieldName="heroImage"
          />
        )}
        {select === "heroVideo" && heroVideo && (
          <SimpleVideo
            autoplay={true}
            loop={true}
            className="video"
            videoUrl={heroVideo}
            documentId={_id}
            documentType={_type}
            sanityFieldName="heroVideo"
          />
        )}
      </article>
    );
  })()
}

<style>
  .audience {
    border-radius: var(--space-2xs);
    overflow: hidden;
    position: relative;
    display: flex;
    flex-direction: column;
    /* Breedte en hoogte bepaalt de parent (BlockAudiencesOverviewSection). */
    inline-size: 100%;
    block-size: 100%;
    background-color: var(--off-black, #111);

    .content-wrapper {
      padding: var(--space-s);
      border-radius: var(--space-3xs);
      background: rgba(0, 0, 0, 0.4);
      backdrop-filter: blur(calc(var(--space-s) / 2));
      position: absolute;
      inset-inline: var(--space-s);
      bottom: var(--space-s);
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: flex-start;

      @media (min-width: 767px) {
        max-width: 50%;
        padding: 2.25rem;
      }

      .content-title-link {
        color: var(--color-gray-50) !important;
        .title {
          font-family: var(--font-primary);
          font-size: var(--fs-1);
          font-weight: 600;
          margin-bottom: 0.75rem;
          line-height: 112%;
          color: var(--color-gray-50);
        }
      }

      .intro {
        font-size: var(--fs--1);
        line-height: 150%;
        margin-bottom: 1.5rem;
        color: var(--color-gray-50);
        font-weight: 500;
        letter-spacing: 0.016rem;
        font-family: var(--font-primary);
      }
      .audience-btn {
        display: block;
      }
    }

    /* figure en video komen uit child-componenten, dus :global(). */
    :global(figure),
    :global(video.video) {
      position: absolute;
      inset: 0;
      inline-size: 100%;
      block-size: 100%;
      z-index: 1;
    }

    :global(.image),
    :global(video.video) {
      inline-size: 100%;
      block-size: 100%;
      object-fit: cover;
      border-radius: var(--space-2xs);
    }
  }
</style>
