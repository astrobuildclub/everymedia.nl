---
import { PortableText } from "astro-portabletext";
import type { ProjectType } from "../utils";
import SanityImage from "./commons/SanityImage.astro";

interface Props {
  projects: ProjectType[];
}
const { projects = [] } = Astro.props || {};
---

{
  (() => {
    return (
      <div>
        {projects?.length > 0 && (
          <div class="block-work-grid-card-inner">
            {projects?.map((item) => {
              const { title, heroImage, select, heroVideo, subtitle, intro } =
                item || {};
              return (
                <article>
                  <div class="project__meta">
                    <div>
                      {select === "heroImage" && heroImage && (
                        <div class="media-container">
                          <SanityImage src={heroImage} className="media" />
                        </div>
                      )}
                      {select === "heroVideo" && heroVideo && (
                        <div class="media-container">
                          <video
                            class="media"
                            autoplay
                            loop
                            playsinline
                            muted
                            preload="auto"
                            poster="https://picsum.photos/696/391"
                          >
                            <source src={heroVideo} type="video/mp4" />
                            {`Your browser does not support the video tag.`}
                          </video>
                        </div>
                      )}
                    </div>
                    <div class="project__meta">
                      <div class="meta">
                        <h4>{`Client`}</h4>
                        <p>{`Award Plain Text`}</p>
                      </div>
                      <div class="project-details">
                        {title && <h3>{title}</h3>}
                        {subtitle && <span>{subtitle}</span>}
                        {intro && (
                          <div class="intro-text">
                            <PortableText value={intro} />
                          </div>
                        )}
                      </div>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        )}
      </div>
    );
  })()
}

<style>
  .block-work-grid-card-inner {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-s);

    @media (max-width: 767px) {
      grid-template-columns: repeat(1, 1fr);
    }

    .project__meta {
      .meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.375rem;

        h4 {
          font-family: var(--font-mono);
          color: var(--blue-gray-700);
          font-weight: 500;
          letter-spacing: 3%;
          text-transform: uppercase;
          font-size: 0.75rem;
        }

        p {
          font-family: var(--font-mono);
          font-size: 0.651rem;
          color: var(--blue-gray-800);
          background-color: var(--blue-gray-200);
          border-radius: 9999px;
          letter-spacing: 3%;
          font-weight: 500;
          text-transform: uppercase;
          padding: 0.313rem 0.563rem;
          line-height: 100%;
        }
      }

      .project-details {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;

        h3 {
          font-weight: 700;
          font-family: var(--font-heading);
          font-size: var(--fs-2);
          letter-spacing: -0.025em;
          line-height: 1;
          color: #111827;
          text-transform: uppercase;
        }

        span {
          color: #000;
          font-size: var(--fs--1);
          letter-spacing: -2%;
          line-height: 112%;
          font-weight: 500;
        }

        .intro-text {
          color: var(--gray-800);
          font-size: var(--fs--2);
          font-weight: normal;
          line-height: 150%;
        }
      }
    }

    .media-container {
      border-radius: 0.75rem;
      margin-bottom: 0.75rem;
      width: 100%;

      .media {
        border-radius: 0.75rem;
        aspect-ratio: 696 / 391;
        width: 100%;
      }
    }
  }
</style>
