---
import type { ProjectType } from "../utils";
import ProjectOverview from "./commons/ProjectOverview.astro";

interface Props {
  projects: ProjectType[];
}
const { projects = [] } = Astro.props || {};
---

{
  (() => {
    return (
      <div>
        {projects?.length > 0 && (
          <div class="block-work-grid-card-inner">
            {projects?.map((item) => {
              return <ProjectOverview project={item} />;
            })}
          </div>
        )}
      </div>
    );
  })()
}

<style>
  .block-work-grid-card-inner {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-s);

    @media (max-width: 767px) {
      grid-template-columns: repeat(1, 1fr);
    }
  }
</style>
