---
import type { FooterType } from "../utils";
import { PortableText } from "astro-portabletext";

interface Props {
  footer: FooterType | undefined;
}

const { footerLinks = [], title } = Astro.props?.footer || {};
---

<footer class="footer">
  <div class="footer-content">
    {
      title && (
        <div class="footer-heading">
          <PortableText value={title} />
        </div>
      )
    }
    {
      footerLinks?.length > 0 && (
        <div class="footer-links">
          {footerLinks?.map((item) => (
            <div class="footer-item">
              {item?.title && <div class="footer-title">{item?.title}</div>}
              {item?.select === "body" && item?.body && (
                <div class="footer-body">
                  <PortableText value={item?.body} />
                </div>
              )}
              {item?.select === "labelLinks" &&
                item?.labelLinks?.length > 0 && (
                  <ul class="footer-links-list">
                    {item?.labelLinks?.map((link) => (
                      <li>{link?.label}</li>
                    ))}
                  </ul>
                )}
            </div>
          ))}
        </div>
      )
    }
  </div>
</footer>

<style>
  footer {
    padding-left: var(--space-s);
    padding-right: var(--space-s);
    padding-top: 6.75rem;
    padding-bottom: 2.25rem;
    /* width: 100%; */
    color: var(--clr-secondary);
    background-color: var(--dark-blue);

    @media (min-width: 1023px) {
      padding-top: 11rem;
    }

    @media (min-width: 767px) {
      padding-bottom: 4.5rem;
    }

    .footer-content {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      vertical-align: bottom;

      .footer-heading {
        text-align: center;
        h2 {
          font-size: 20vw;
          font-weight: 800;
          text-transform: uppercase;
          text-align: center;
          color: white;
          white-space: nowrap;
          line-height: 100%;
          font-family: var(--font-heading);
          width: 100%;
          @media (max-width: 1023px) {
            font-size: 18vw;
          }
        }
      }

      .footer-links {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--space-xs);
        margin-top: 2.5rem;
        align-self: flex-end;

        @media (min-width: 767px) {
          grid-template-columns: 3.5fr 1fr 1fr 1fr;
        }

        @media (min-width: 1279px) {
          margin-left: 2rem;
        }

        .footer-item {
          .footer-title {
            font-size: 0.75rem;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 3%;
            font-family: var(--font-mono);
            line-height: 150%;
            margin-bottom: 1.125rem;
            opacity: 0.5;
            display: block;
            cursor: default;
            color: var(--gray-50);
          }

          .footer-body {
            font-size: var(--fs--2);
            font-weight: 400;
            color: white;
            text-wrap: balance;
            font-family: var(--font-primary);
            line-height: 150%;
            text-rendering: optimizeLegibility;
          }

          .footer-links-list {
            font-size: var(--fs--2);
            font-weight: 500;
            line-height: var(--leading-tight);
            margin: 0;
            padding: 0;

            li {
              font-size: var(--fs--2);
              font-weight: 400;
              text-wrap: balance;
              color: white;
              font-family: var(--font-primary);
              line-height: 150%;
              text-rendering: optimizeLegibility;
              cursor: pointer;
              transition: all 0.3s;
              width: fit-content;

              &:hover {
                opacity: 0.5;
              }
            }
          }
        }
      }
    }
  }
</style>
