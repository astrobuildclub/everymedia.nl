---
import type { FooterType } from "../utils";
import { PortableText } from "astro-portabletext";
import SanityLink from "./commons/SanityLink.astro";

interface Props {
  footer: FooterType | undefined;
}

const { footerLinks = [], title } = Astro.props?.footer || {};
---

{
  (() => {
    return (
      <footer class="footer">
        <div class="footer-content">
          {title && (
            <div class="footer-heading">
              <PortableText value={title} />
            </div>
          )}
          {footerLinks?.length > 0 && (
            <div class="footer-links">
              {footerLinks?.map((item) => {
                const { title, body, labelLinks, select } = item || {};
                return (
                  <div class="footer-item">
                    {title && <div class="footer-title">{title}</div>}
                    {select === "body" && body && (
                      <div class="footer-body">
                        <PortableText value={body} />
                      </div>
                    )}
                    {select === "labelLinks" && labelLinks?.length > 0 && (
                      <ul class="footer-links-list">
                        {labelLinks?.map((item) => {
                          const { label, link } = item || {};                          
                          return (
                            <li>
                              <SanityLink
                                href={link}
                                class="footer-labelLink"
                              >
                                {label}
                              </SanityLink>
                            </li>
                          );
                        })}
                      </ul>
                    )}
                  </div>
                );
              })}
            </div>
          )}
        </div>
      </footer>
    );
  })()
}

<style>
  footer {
    padding-left: var(--space-s);
    padding-right: var(--space-s);
    padding-top: 6.75rem;
    padding-bottom: 2.25rem;
    color: var(--clr-secondary);
    background-color: var(--dark-blue);

    @media (min-width: 1023px) {
      padding-top: 11rem;
    }

    @media (min-width: 767px) {
      padding-bottom: 4.5rem;
    }

    .footer-content {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      vertical-align: bottom;

      .footer-heading {
        text-align: center;
        h2 {
          font-size: 20vw;
          font-weight: 800;
          text-transform: uppercase;
          text-align: center;
          color: white;
          white-space: nowrap;
          line-height: 100%;
          font-family: var(--font-heading);
          width: 100%;
          @media (max-width: 1023px) {
            font-size: 18vw;
          }
        }
      }

      .footer-links {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--space-xs);
        margin-top: 2.5rem;
        align-self: flex-end;

        @media (min-width: 767px) {
          grid-template-columns: 3.5fr 1fr 1fr 1fr;
        }

        @media (min-width: 1279px) {
          margin-left: 2rem;
        }

        .footer-item {
          .footer-title {
            font-size: 0.75rem;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 3%;
            font-family: var(--font-mono);
            line-height: 150%;
            margin-bottom: 1.125rem;
            opacity: 0.5;
            display: block;
            cursor: default;
            color: var(--gray-50);
          }

          .footer-body {
            font-size: var(--fs--2);
            font-weight: 400;
            color: white;
            text-wrap: balance;
            font-family: var(--font-primary);
            line-height: 150%;
            text-rendering: optimizeLegibility;
          }

          .footer-links-list {
            font-size: var(--fs--2);
            font-weight: 500;
            line-height: var(--leading-tight);
            margin: 0;
            padding: 0;

            .footer-labelLink {
              font-size: var(--fs--2);
              font-weight: 400;
              text-wrap: balance;
              color: white;
              font-family: var(--font-primary);
              line-height: 150%;
              text-rendering: optimizeLegibility;
              cursor: pointer;
              transition: all 0.3s;
              width: fit-content;
              text-decoration: none;
              &:hover {
                opacity: 0.5;
              }
            }
          }
        }
      }
    }
  }
</style>
