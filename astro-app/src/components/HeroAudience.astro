---
import { PortableText } from "astro-portabletext";
import type { HeroViewType } from "../utils";
import SanityImage from "./commons/SanityImage.astro";
import DownArrow from "./icons/downArrow";
import SimpleVideo from "./commons/SimpleVideo.astro";

interface Props {
  data: HeroViewType;
}
const { title, heroVideo, subtitle, heroImage, select, intro } =
  Astro.props.data || {};
---

{
  (() => {
    return (
      <section class="audience-section">
        <div class="container">
          <div class="audience-hero-title">
            <div class="audience-hero-title-inner">
              {title && <h1 class="audience-banner-title">{title}</h1>}
              <div class="desc-with-icon">
                {subtitle && <p class="audience-banner-desc">{subtitle}</p>}
                <DownArrow className="skip-icon" />
              </div>
            </div>
            {intro && (
              <div class="banner-sub-desc">
                <PortableText value={intro} />
              </div>
            )}
          </div>
          {select === "heroVideo" && heroVideo && (
            <div class="audience-bg">
              <SimpleVideo
                autoplay={true}
                loop={true}
                className=""
                videoUrl={heroVideo}
              />
            </div>
          )}
          {select === "heroImage" && heroImage && (
            <div class="">
              <SanityImage
                src={heroImage}
                className="sanity-image audience-bg"
              />
            </div>
          )}
        </div>
        <DownArrow className="skip-icon-mobie" />
      </section>
    );
  })()
}

<style>
  .audience-section {
    position: relative;
    min-height: 100dvh;
    width: 100%;

    .container {
      .audience-hero-title {
        padding: var(--space-s);
        display: grid;
        gap: var(--space-xl);
        grid-column-start: 1;
        position: absolute;
        bottom: 6.75rem;
        z-index: 1;
        left: 0;
        right: 0;
        @media (max-width: 767px) {
          gap: 1rem;
          bottom: 4.5rem;
        }

        .audience-hero-title-inner {
          width: 100%;
          .audience-banner-title {
            font-size: var(---fs---1);
            color: white;
            font-weight: 800;
            line-height: 100%;
            text-transform: uppercase;
            font-family: var(--font-heading);
          }

          .desc-with-icon {
            position: relative;

            .audience-banner-desc {
              margin-top: 0.375rem;
              font-size: var(--fs-1);
              font-weight: 700;
              line-height: 120%;
              font-family: var(--font-heading);
              color: white;
            }
            .skip-icon {
              position: absolute;
              right: 1rem;
              top: 0;
              @media (max-width: 767px) {
                display: none;
              }
            }
          }
        }

        .banner-sub-desc {
          color: white;
          font-weight: 500;
          line-height: 133%;
          letter-spacing: -0.03px;
          font-family: var(--font-primary);
          padding-left: 10%;
          max-width: 58.5rem;
          width: 100%;
          font-size: var(---fs---2);
          @media (max-width: 1279px) {
            padding-left: 0%;
          }
        }
      }
      .audience-bg {
        position: absolute;
        top: calc(var(--spacing) * 0);
        width: 100%;
        height: 100%;
        object-fit: cover;

        video {
          width: 100%;
          height: 100%;
          object-fit: cover;
        }
      }
      .audience-bg {
        position: absolute;
        top: calc(var(--spacing) * 0);
        width: 100%;
        height: 100%;
        object-fit: cover;

        .sanity-image {
          width: 100%;
          height: 100%;
          object-fit: cover;
        }
      }
    }

    .skip-icon-mobie {
      display: none;
      @media (max-width: 767px) {
        display: block;
        position: absolute;
        bottom: -1.5rem;
        right: 1.5rem;
      }
    }
  }
</style>
