---
import { cn } from "../lib/helperFunctions";
import { routes } from "../lib/router";
import type { HeaderType } from "../utils";
import SanityImage from "./commons/SanityImage.astro";

interface Props {
  header: HeaderType | undefined;
  isHeroVideo: boolean | undefined;
}

const { header, isHeroVideo } = Astro.props || {};
const { logo, navItems = []} = header || {};
---

<header
  id="site-header"
  class={cn("", isHeroVideo ? "bg-transparent" : "menu-background")}
>
  <div class="container">
    <a href={routes.home()}>
      <SanityImage src={logo} className="" />
    </a>

    <div class="menu-container">
      <div class="social-buttons">
        <button>
          {`IG`}
        </button>
        <button>
          {`LI`}
        </button>
      </div>
      <button class="menu-buttons open-menu open-menu-button">
        {`Menu`}
      </button>
      <button class="close-menu close-button close-menu-button hidden">
        {`Close`}
      </button>
      {
        navItems?.length > 0 && (
          <nav id="menu" class="show-nav nav hidden">
            <div class="nav-items">
              {navItems?.map((item) => (
                <div class="nav-item">
                  {item.headline && (
                    <div class="headline ">{item?.headline}</div>
                  )}
                  {item?.labelLinks?.length > 0 &&
                    item?.labelLinks?.map((labelItem) => (
                      <div class="label">{labelItem?.label}</div>
                    ))}
                </div>
              ))}
            </div>
          </nav>
        )
      }
    </div>
  </div>
</header>

<style>
  header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
    padding: 0.75rem 1.125rem;
    @media (min-width: 1023px) {
      padding: 0.75rem 1.5rem;
    }

    &.bg-transparent {
      background-color: transparent;
    }
    &.menu-background {
      background-color: var(--dark-blue);
    }
    .container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      max-width: 100%;
    }

    a {
      img {
        max-width: 5.563rem;
        height: 1rem;
        @media (min-width: 639px) {
          max-width: 8.25rem;
          height: 1.5rem;
        }
      }
    }
    .hidde-button {
      display: none;
    }
    .menu-container {
      display: flex;
      gap: 0.5rem;
    }

    .social-buttons {
      display: none;
      align-items: center;
      gap: 0.5rem;
      @media (min-width: 1023px) {
        display: flex;
      }

      button {
        width: 2.5rem;
        height: 2.5rem;
        background-color: var(--white-clr);
        color: white;
        border: none;
        outline: none;
        text-transform: uppercase;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 50%;
        font-size: 0.75rem;
        font-weight: 500;
        font-family: var(--font-mono);
        cursor: pointer;
      }
    }

    .menu-buttons {
      text-transform: uppercase;
      padding: 0.75rem 1.5rem;
      border-radius: 1.875rem;
      cursor: pointer;
      font-size: 0.75rem;
      text-align: center;
      font-family: var(--font-mono);
      border: none;
      outline: none;
      line-height: 100%;

      &.open-menu {
        background-color: var(--charcoal-gray);
        color: white;
        width: 5rem;
      }
    }
    .close-menu {
      background-color: white;
      color: var(--color-gray-900);
      width: 5rem;
      text-transform: uppercase;
      padding-block: 0.75rem;
      padding-inline: 1.5rem;
      cursor: pointer;
      border-radius: 1.875rem;
      cursor: pointer;
      font-size: 0.75rem;
      line-height: 100%;
      text-align: center;
      font-family: var(--font-mono);
      border: none;
      outline: none;
    }
    .show-nav {
      display: none;
    }
    .hidden {
      display: none !important;
    }

    .nav {
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      background-color: var(--dark-blue);
      box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
      overflow-y: auto;
      z-index: 1;

      .nav-items {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 1.125rem;

        .nav-item {
          text-align: center;

          .headline {
            color: white;
            font-size: 0.75rem;
            line-height: 150%;
            letter-spacing: 3%;
            font-weight: 500;
            text-transform: uppercase;
            cursor: pointer;
            font-family: var(--font-mono);
          }

          .label {
            color: white;
            font-size: var(--fs-9);
            font-family: var(--font-heading);
            line-height: 90%;
            font-weight: 800;
            text-transform: uppercase;
            cursor: pointer;
            transition: opacity 0.3s ease-in-out;
            &:hover {
              opacity: 0.5;
            }
          }
        }
      }
    }
  }
</style>

<script>
  const openMenuButton = document.querySelector(".open-menu-button");
  const menuBackground = document.querySelector("header");
  const closeMenuButton = document.querySelector(".close-menu-button");
  const menu = document.querySelector("#menu");

  openMenuButton?.addEventListener("click", () => {
    menu?.classList.remove("hidden");
    openMenuButton?.classList.add("hidden");
    menuBackground?.classList.add("menu-background");
    closeMenuButton?.classList.remove("hidden");
    // Prevent scrolling more effectively
    document.body.style.position = "fixed";
    document.body.style.width = "100%";
    document.body.style.overflowY = "scroll";
  });

  closeMenuButton?.addEventListener("click", () => {
    menu?.classList.add("hidden");
    menuBackground?.classList.remove("menu-background");
    closeMenuButton?.classList.add("hidden");
    openMenuButton?.classList.remove("hidden");
    document.body.style.position = "";
    document.body.style.width = "";
    document.body.style.overflowY = "";
  });
</script>
