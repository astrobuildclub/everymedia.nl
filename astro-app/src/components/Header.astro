---
import { cn } from "../lib/helperFunctions";
import { routes } from "../lib/router";
import type { HeaderType, HeroVariantType } from "../utils";
import SanityImage from "./commons/SanityImage.astro";
import SanityLink from "./commons/SanityLink.astro";

interface Props {
  header: HeaderType | undefined;
  isHeroVideo: boolean | undefined;
  heroVariants: HeroVariantType;
}

const { header, isHeroVideo, heroVariants } = Astro.props || {};
const { logo, navItems = [] } = header || {};
const LogoClass = (heroVariants: HeroVariantType) => {
  switch (heroVariants) {
    case "audience":
      return "logo-audience ";
    case "homepage":
      return "logo-homepage ";
    case "page":
      return "logo-page ";
    case "project":
      return "logo-project";
    default:
      return "";
  }
};
const ButtonClass = (heroVariants: HeroVariantType) => {
  switch (heroVariants) {
    case "audience":
      return " laug-cta-audience";
    case "homepage":
      return " laug-cta-homepage";
    case "page":
      return " laug-cta-page";
    case "project":
      return " laug-cta-project";
    default:
      return "";
  }
};
const MenuClass = (heroVariants: HeroVariantType) => {
  switch (heroVariants) {
    case "audience":
      return " menu-cta-audience";
    case "homepage":
      return " menu-cta-homepage";
    case "page":
      return " menu-cta-page";
    case "project":
      return " menu-cta-project";
    default:
      return "";
  }
};
---

{
  (() => {
    return (
      <header
        id="site-header"
        class={cn("", isHeroVideo ? "bg-transparent" : "menu-background")}
      >
        <div class="container">
          <SanityLink href={routes.home()}>
            <SanityImage
              src={logo}
              className={cn("logo-class", LogoClass(heroVariants))}
            />
          </SanityLink>

          <div class="menu-container">
            <div class="social-buttons">
              <button class={cn("button", ButtonClass(heroVariants))}>{`IG`}</button>
              <button class={cn("button", ButtonClass(heroVariants))}>{`LI`}</button>
            </div>
            <button 
            class={cn("menu-buttons open-menu open-menu-button", MenuClass(heroVariants))})}
            >
              {`Menu`}
            </button>
            <button class={cn("close-menu close-button close-menu-button hidden",MenuClass(heroVariants))}>
              {`Close`}
            </button>
            {navItems?.length > 0 && (
              <nav id="menu" class="show-nav nav hidden">
                <div class="nav-items">
                  {navItems?.map((item) => {
                    const { headline, labelLinks } = item || {};
                    return (
                      <div class="nav-item">
                        {headline && <div class="headline ">{headline}</div>}
                        {labelLinks?.length > 0 &&
                          labelLinks?.map((item) => {
                            const { label, link } = item || {};
                            return (
                              <div>
                                <SanityLink class="label" href={link}>
                                  {label}
                                </SanityLink>
                              </div>
                            );
                          })}
                      </div>
                    );
                  })}
                </div>
              </nav>
            )}
          </div>
        </div>
      </header>
    );
  })()
}

<style>
  header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
    padding: 0.75rem 1.125rem;
    @media (min-width: 1023px) {
      padding: 0.75rem 1.5rem;
    }

    &.bg-transparent {
      background-color: transparent;
    }
    &.menu-background {
      background-color: var(--dark-blue);
    }
    .container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      max-width: 100%;
    }

    .logo-menu-open {
     filter: grayscale(1) !important;
}

    a {
      img {
        max-width: 5.563rem;
        height: 1rem;
        @media (min-width: 639px) {
          max-width: 8.25rem;
          height: 1.5rem;
        }
      }
    }

    .logo-page{
      filter: invert(1);
    }

    .logo-audience{
      filter: brightness(0.2);
    }

    .hidde-button {
      display: none;
    }
    .menu-container {
      display: flex;
      gap: 0.5rem;
    }

    .social-buttons {
      display: none;
      align-items: center;
      gap: 0.5rem;
      @media (min-width: 1023px) {
        display: flex;
      }

      .button {
        width: 2.5rem;
        height: 2.5rem;
        border: none;
        outline: none;
        text-transform: uppercase;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 50%;
        font-size: 0.75rem;
        font-weight: 500;
        font-family: var(--font-mono);
        cursor: pointer;
      }

      .laug-cta-homepage{
        background-color: var(--white-clr);
        color: white;
      }
      .laug-cta-audience{
        background-color: var(--light-gray);
        color: #2c2c2c;
      }
      .laug-cta-page{
          background-color: var(--platinum-gray);
          color: black;
      }
      .laug-cta-project{
          background-color: var(--eerie-black);
          color: white;
      }
    }

    .menu-buttons {
      text-transform: uppercase;
      padding: 0.75rem 1.5rem;
      border-radius: 1.875rem;
      cursor: pointer;
      font-size: 0.75rem;
      text-align: center;
      font-family: var(--font-mono);
      border: none;
      outline: none;
      line-height: 100%;
      background-color: var(--charcoal-gray);
      color: white;
      width: 5rem;
    }

    .menu-cta-audience{
           background-color: var(--ash-gray); 
           color: black;
      }

    .menu-cta-homepage{
           background-color: var(--charcoal-gray); 
           color: white;
      }

    .menu-cta-page{
           background-color: var(--light-sage); 
           color: black;
      }

    .menu-cta-project{
           background-color: var(--charcoal-gray); 
           color: white;
      }

    .close-menu {
      background-color: white;
      color: black;
      width: 5rem;
      text-transform: uppercase;
      padding-block: 0.75rem;
      padding-inline: 1.5rem;
      cursor: pointer;
      border-radius: 1.875rem;
      cursor: pointer;
      font-size: 0.75rem;
      line-height: 100%;
      text-align: center;
      font-family: var(--font-mono);
      border: none;
      outline: none;
    }

   
    .show-nav {
      display: none;
    }
    .hidden {
      display: none !important;
    }

    .nav {
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      background-color: var(--dark-blue);
      box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
      overflow-y: auto;
      z-index: 1;

      .nav-items {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 1.125rem;

        .nav-item {
          text-align: center;

          .headline {
            color: white;
            font-size: 0.75rem;
            line-height: 150%;
            letter-spacing: 3%;
            font-weight: 500;
            text-transform: uppercase;
            cursor: pointer;
            font-family: var(--font-mono);
          }

          .label {
            color: white;
            font-size: var(--fs-9);
            font-family: var(--font-heading);
            line-height: 90%;
            font-weight: 800;
            text-transform: uppercase;
            cursor: pointer;
            transition: opacity 0.3s ease-in-out;
            text-decoration: none;
            &:hover {
              opacity: 0.5;
            }
          }
        }
      }
    }
  }
</style>

<script>
  const openMenuButton = document.querySelector(".open-menu-button");
  const closeMenuButton = document.querySelector(".close-menu-button");
  const menu = document.querySelector("#menu");
  const menuBackground = document.querySelector("header");
  const logo = document.querySelector(".logo-class"); 

  openMenuButton?.addEventListener("click", () => {
    menu?.classList.remove("hidden");
    openMenuButton?.classList.add("hidden");
    closeMenuButton?.classList.remove("hidden");
    menuBackground?.classList.add("menu-background");

    logo?.classList.add("logo-menu-open");

    document.body.style.position = "fixed";
    document.body.style.width = "100%";
    document.body.style.overflowY = "scroll";
  });

  closeMenuButton?.addEventListener("click", () => {
    menu?.classList.add("hidden");
    menuBackground?.classList.remove("menu-background");
    closeMenuButton?.classList.add("hidden");
    openMenuButton?.classList.remove("hidden");

    logo?.classList.remove("logo-menu-open");

    document.body.style.position = "";
    document.body.style.width = "";
    document.body.style.overflowY = "";
  });
</script>

