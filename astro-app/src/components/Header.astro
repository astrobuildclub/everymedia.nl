---
import { stegaClean } from "@sanity/client/stega";
import { cn } from "../lib/helperFunctions";
import { routes } from "../lib/router";
import type {
  HeaderType,
  HeroVariantType,
  NavItemType,
  LabelLinkType,
} from "../utils";
import SanityLink from "./commons/SanityLink.astro";

interface Props {
  header: HeaderType | undefined;
  heroVariants: HeroVariantType;
}

const { header, heroVariants: HeroVariants } = Astro.props || {};
const { logo, navItems = [], _type, _id } = header || {};
const heroVariants = stegaClean(HeroVariants);

const LogoClass = (heroVariants: HeroVariantType) => {
  switch (heroVariants) {
    case "audience":
      return "logo-audience ";
    case "homepage":
      return "logo-homepage ";
    case "page":
      return "logo-page ";
    case "project":
      return "logo-project";
    default:
      return "";
  }
};
const ButtonClass = (heroVariants: HeroVariantType) => {
  switch (heroVariants) {
    case "audience":
      return " laug-cta-audience";
    case "homepage":
      return " laug-cta-homepage";
    case "page":
      return " laug-cta-page";
    case "project":
      return " laug-cta-project";
    default:
      return "";
  }
};
const MenuClass = (heroVariants: HeroVariantType) => {
  switch (heroVariants) {
    case "audience":
      return " menu-cta-audience";
    case "homepage":
      return " menu-cta-homepage";
    case "page":
      return " menu-cta-page";
    case "project":
      return " menu-cta-project";
    default:
      return "";
  }
};
---

{
  (() => {
    return (
      <header id="site-header" class={cn("bg-transparent")}>
        <div class="container">
          <SanityLink href={routes.home()}>
            <svg
              width="133"
              height="24"
              viewBox="0 0 89 16"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              class={cn("logo-class", LogoClass(heroVariants))}
            >
              <g style="mix-blend-mode:difference">
                <path
                  d="M0 15.876V0H7.02V3.2184H3.6504V6.2748H6.5664V9.4932H3.6504V12.6576H7.0848V15.876H0Z"
                  fill="white"
                />
                <path
                  d="M8.8857 15.876L7.3197 0H10.8621L11.7801 12.3768H11.8233L12.7305 0H16.1973L14.6205 15.876H8.8857Z"
                  fill="white"
                />
                <path
                  d="M16.7063 15.876V0H23.7263V3.2184H20.3567V6.2748H23.2727V9.4932H20.3567V12.6576H23.7911V15.876H16.7063Z"
                  fill="white"
                />
                <path
                  d="M24.5109 15.876V0H28.7121C29.4105 0 30.0225 0.0719999 30.5481 0.216C31.0809 0.352799 31.5201 0.572399 31.8657 0.8748C32.2185 1.17 32.4813 1.5444 32.6541 1.998C32.8341 2.4516 32.9241 2.9916 32.9241 3.618V6.156C32.9241 6.5592 32.8809 6.9264 32.7945 7.2576C32.7153 7.5816 32.5965 7.8732 32.4381 8.1324C32.2797 8.3844 32.0781 8.604 31.8333 8.7912C31.5957 8.9784 31.3185 9.1368 31.0017 9.2664C30.6921 9.3888 30.3393 9.4788 29.9433 9.5364C29.5545 9.594 29.1297 9.6228 28.6689 9.6228H28.1613V15.876H24.5109ZM28.1613 7.0416H28.5285C28.6365 7.0416 28.7301 7.0272 28.8093 6.9984C28.8885 6.9696 28.9533 6.93 29.0037 6.8796C29.0541 6.822 29.0901 6.7464 29.1117 6.6528C29.1333 6.5592 29.1441 6.444 29.1441 6.3072V3.618C29.1441 3.4812 29.1333 3.366 29.1117 3.2724C29.0901 3.1788 29.0541 3.1068 29.0037 3.0564C28.9533 2.9988 28.8885 2.9556 28.8093 2.9268C28.7301 2.898 28.6365 2.8836 28.5285 2.8836H28.1613V7.0416ZM29.7165 15.876L28.1937 8.856L31.6497 8.4996L33.3669 15.876H29.7165Z"
                  fill="white"
                />
                <path
                  d="M35.7468 15.876V11.664L32.6796 0H36.5352L37.2912 4.7304L37.6044 7.0848H37.6584L37.9716 4.7304L38.7168 0H42.4644L39.3972 11.664V15.876H35.7468Z"
                  fill="white"
                />
                <path
                  d="M44.7609 15.876V0H49.8909L50.7117 12.366H50.7873L51.5973 0H56.7273V15.876H53.3793V12.2904L53.6277 3.1212H53.5521L52.5045 15.876H48.9837L47.9361 3.1212H47.8713L48.0981 12.2904V15.876H44.7609Z"
                  fill="white"
                />
                <path
                  d="M57.6703 15.876V0H64.6903V3.2184H61.3207V6.2748H64.2367V9.4932H61.3207V12.6576H64.7551V15.876H57.6703Z"
                  fill="white"
                />
                <path
                  d="M65.475 15.876V0H69.7302C70.2342 0 70.6878 0.036 71.091 0.108C71.5014 0.18 71.865 0.2916 72.1818 0.4428C72.4986 0.5868 72.7686 0.774 72.9918 1.0044C73.2222 1.2348 73.4094 1.5048 73.5534 1.8144C73.6974 2.124 73.8054 2.4804 73.8774 2.8836C73.9494 3.2796 73.9854 3.7188 73.9854 4.2012V11.6748C73.9854 12.1572 73.9494 12.6 73.8774 13.0032C73.8054 13.3992 73.6974 13.752 73.5534 14.0616C73.4094 14.3712 73.2222 14.6412 72.9918 14.8716C72.7686 15.102 72.4986 15.2928 72.1818 15.444C71.865 15.588 71.5014 15.696 71.091 15.768C70.6878 15.84 70.2342 15.876 69.7302 15.876H65.475ZM69.1254 12.9492H69.4602C69.5538 12.9492 69.6366 12.942 69.7086 12.9276C69.7806 12.906 69.8418 12.8772 69.8922 12.8412C69.9498 12.8052 69.9966 12.7548 70.0326 12.69C70.0686 12.6252 70.0974 12.546 70.119 12.4524C70.1406 12.3516 70.1586 12.24 70.173 12.1176C70.1874 11.988 70.1946 11.8368 70.1946 11.664V4.2012C70.1946 4.0356 70.1874 3.888 70.173 3.7584C70.1586 3.6288 70.1406 3.5172 70.119 3.4236C70.0974 3.33 70.0686 3.2508 70.0326 3.186C69.9966 3.1212 69.9498 3.0708 69.8922 3.0348C69.8418 2.9988 69.7806 2.9736 69.7086 2.9592C69.6366 2.9376 69.5538 2.9268 69.4602 2.9268H69.1254V12.9492Z"
                  fill="white"
                />
                <path
                  d="M74.7984 15.876V0H78.4488V15.876H74.7984Z"
                  fill="white"
                />
                <path
                  d="M78.9757 15.876L80.5633 0H86.5681L88.1665 15.876H84.5701L84.2893 12.1284H82.8637L82.5829 15.876H78.9757ZM83.0905 9.2124H84.0517L83.6089 2.862H83.5333L83.0905 9.2124Z"
                  fill="white"
                />
              </g>
            </svg>
          </SanityLink>

          <div class="menu-container">
            <div class="social-buttons">
              <button
                class={cn("button", ButtonClass(heroVariants))}
              >{`IG`}</button>
              <button
                class={cn("button", ButtonClass(heroVariants))}
              >{`LI`}</button>
            </div>
            <button
              class={cn(
                "menu-buttons open-menu open-menu-button",
                MenuClass(heroVariants)
              )}
            >
              {`Menu`}
            </button>
            <button
              class={cn(
                "close-menu close-button close-menu-button hidden",
                MenuClass(heroVariants)
              )}
            >
              {`Close`}
            </button>
          </div>
        </div>
        {navItems?.length > 0 && (
          <nav id="menu" class="show-nav nav hidden">
            <div class="nav-items">
              {navItems?.map((item: NavItemType) => {
                const { headline, labelLinks } = item || {};
                return (
                  <div class="nav-item">
                    {headline && <div class="headline ">{headline}</div>}
                    {labelLinks?.length > 0 &&
                      labelLinks?.map((item: LabelLinkType) => {
                        const { label, link } = item || {};
                        return (
                          <div>
                            <SanityLink class="label" href={link}>
                              {label}
                            </SanityLink>
                          </div>
                        );
                      })}
                  </div>
                );
              })}
            </div>
          </nav>
        )}
      </header>
    );
  })()
}

<style>
  header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
    padding: 0.75rem 1.125rem;
    @media (min-width: 1023px) {
      padding: 0.75rem 1.5rem;
    }

    &.bg-transparent {
      background-color: transparent;
    }
    &.menu-background {
      background-color: var(--dark-blue);
    }
    .container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      max-width: 100%;
      position: relative;
      z-index: 10;
    }

    .logo-menu-open {
      filter: grayscale(1) !important;
    }

    a {
      svg,
      img {
        max-width: 5.563rem;
        height: 1rem;
        @media (min-width: 639px) {
          max-width: 8.25rem;
          height: 1.5rem;
        }
      }
    }

    .logo-page {
      filter: invert(1);
    }

    /* .logo-audience {
      filter: brightness(0.2);
    } */

    .hidde-button {
      display: none;
    }
    .menu-container {
      display: flex;
      gap: 0.5rem;
    }

    .social-buttons {
      display: none;
      align-items: center;
      gap: 0.5rem;
      @media (min-width: 1023px) {
        display: flex;
      }

      .button {
        width: 2.5rem;
        height: 2.5rem;
        border: none;
        outline: none;
        text-transform: uppercase;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 50%;
        font-size: 0.75rem;
        font-weight: 500;
        font-family: var(--font-mono);
        cursor: pointer;
      }

      .laug-cta-homepage {
        background-color: var(--white-clr);
        color: white;
      }
      .laug-cta-audience {
        background-color: var(--light-gray);
        color: #2c2c2c;
      }
      .laug-cta-page {
        background-color: var(--platinum-gray);
        color: black;
      }
      .laug-cta-project {
        background-color: var(--eerie-black);
        color: white;
      }
    }

    .menu-buttons {
      text-transform: uppercase;
      padding: 0.75rem 1.5rem;
      border-radius: 1.875rem;
      cursor: pointer;
      font-size: 0.75rem;
      text-align: center;
      font-family: var(--font-mono);
      border: none;
      outline: none;
      line-height: 100%;
      background-color: var(--charcoal-gray);
      color: white;
      width: 5rem;
    }

    .menu-cta-audience {
      background-color: var(--ash-gray);
      color: black;
    }

    .menu-cta-homepage {
      background-color: var(--charcoal-gray);
      color: white;
    }

    .menu-cta-page {
      background-color: var(--light-sage);
      color: black;
    }

    .menu-cta-project {
      background-color: var(--charcoal-gray);
      color: white;
    }

    .close-menu {
      background-color: white;
      color: black;
      width: 5rem;
      text-transform: uppercase;
      padding-block: 0.75rem;
      padding-inline: 1.5rem;
      cursor: pointer;
      border-radius: 1.875rem;
      cursor: pointer;
      font-size: 0.75rem;
      line-height: 100%;
      text-align: center;
      font-family: var(--font-mono);
      border: none;
      outline: none;
    }

    .show-nav {
      display: none;
    }
    .hidden {
      display: none !important;
    }

    .nav {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      background-color: var(--dark-blue);
      box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
      overflow-y: auto;
      z-index: 1;

      .nav-items {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 1.125rem;

        .nav-item {
          text-align: center;

          .headline {
            color: white;
            font-size: 0.75rem;
            line-height: 150%;
            letter-spacing: 3%;
            font-weight: 500;
            text-transform: uppercase;
            cursor: pointer;
            font-family: var(--font-mono);
          }

          .label {
            color: white;
            font-size: var(--fs-9);
            font-family: var(--font-primary);
            line-height: 90%;
            font-weight: 800;
            text-transform: uppercase;
            cursor: pointer;
            transition: opacity 0.3s ease-in-out;
            text-decoration: none;
            &:hover {
              opacity: 0.5;
            }
          }
        }
      }
    }
  }
</style>

<script>
  const openMenuButton = document.querySelector(".open-menu-button");
  const closeMenuButton = document.querySelector(".close-menu-button");
  const menu = document.querySelector("#menu");
  const menuBackground = document.querySelector("header");
  const logo = document.querySelector(".logo-class");

  openMenuButton?.addEventListener("click", () => {
    menu?.classList.remove("hidden");
    openMenuButton?.classList.add("hidden");
    closeMenuButton?.classList.remove("hidden");
    menuBackground?.classList.add("menu-background");

    logo?.classList.add("logo-menu-open");

    document.body.style.position = "fixed";
    document.body.style.width = "100%";
    document.body.style.overflowY = "scroll";
  });

  closeMenuButton?.addEventListener("click", () => {
    menu?.classList.add("hidden");
    menuBackground?.classList.remove("menu-background");
    closeMenuButton?.classList.add("hidden");
    openMenuButton?.classList.remove("hidden");

    logo?.classList.remove("logo-menu-open");

    document.body.style.position = "";
    document.body.style.width = "";
    document.body.style.overflowY = "";
  });
</script>
