---
import type { SanityImageType } from "../utils";
import SanityImage from "./commons/SanityImage.astro";

interface Props {
  data: {
    title: string | undefined;
    subtitle: string | undefined;
    heroVideo: string | undefined;
    heroImage: SanityImageType | undefined;
    select: "heroVideo" | "heroImage" | undefined;
  };
}
const { title, heroVideo, subtitle, heroImage, select } =
  Astro.props.data || {};
---

<section class="hero-section">
  <div class="hero-title">
    {
      title && (
        <div class="title__wrapper">
          <h1 class="em-title">{title}</h1>
        </div>
      )
    }
    {
      subtitle && (
        <div class="title__wrapper">
          <h1 class="em-title">{subtitle}</h1>
        </div>
      )
    }
  </div>
  {
    select === "heroVideo" && heroVideo && (
      <div class="video__wrapper ">
        <video
          class=""
          autoplay
          loop
          playsinline
          muted
          preload="auto"
          poster="https://picsum.photos/696/391"
        >
          <source src={heroVideo} type="video/mp4" />
          {`Your browser does not support the video tag.`}
        </video>
      </div>
    )
  }
  {
    select === "heroImage" && heroImage && (
      <div class="video__wrapper ">
        <SanityImage src={heroImage} className="" />
      </div>
    )
  }
</section>

<style>
  .hero-section {
    position: relative;
    min-height: 100dvh;

    .hero-title {
      position: absolute;
      top: 0;
      width: 100%;
      height: 100%;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      z-index: 5;

      .title__wrapper {
        display: grid;
        padding-left: var(--space-3xs);
        padding-right: var(--space-3xs);

        .em-title {
          font-size: var(--type-size);
          font-weight: bold;
          color: white;
          align-self: flex-end;
          position: sticky;
          bottom: 0;
          margin-bottom: 0 !important;
        }
      }
    }

    .video__wrapper {
      position: absolute;
      top: calc(var(--spacing) * 0);
      width: 100%;
      height: 100%;

      video,
      .sanity-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .sanity-image {
        @media (min-width: 767px) {
          object-position: top;
        }
      }
    }
  }
</style>
