{
  "name": "every-media",
  "description": "Minimal Astro site with Sanity Studio",
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=astro-app\" \"npm run dev --workspace=studio\"",
    "build": "npm run build --workspace=astro-app && rm -rf .netlify && cp -R astro-app/.netlify .netlify",
    "build:studio": "npm run build --workspace=studio"
  },
  "keywords": [
    "Sanity",
    "Astro",
    "Headless CMS",
    "Visual Editing",
    "Live Content API (LCAPI)",
    "Real-time"
  ],
  "bugs": {
    "url": "https://github.com/sanity-io/sanity-template-astro-clean/issues"
  },
  "homepage": "https://github.com/sanity-io/sanity-template-astro-clean#readme",
  "workspaces": [
    "studio",
    "astro-app"
  ],
  "devDependencies": {
    "concurrently": "^9.2.4"
  },
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ajv": "^8.20.0",
    "undici": "^6.29.0",
    "@fastify/busboy": "^3.2.2"
  },
  "type": "module"
}
